---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site";

const base = import.meta.env.BASE_URL;
const img = (name: string) => `${base}shots/tg-paywall/${name}`;
const repo = "https://github.com/jefo/sotajs/tree/main/examples/tg-paywall";
const mailto = `mailto:${site.email}?subject=${encodeURIComponent("Похожий сценарий: платная подписка")}`;

const flow = [
  {
    state: "plan",
    title: "Тариф",
    text: "Админ создаёт план: цена, срок, канал. План — агрегат с инвариантами, а не строка в меню.",
  },
  {
    state: "pending",
    title: "Подписка",
    text: "Пользователь выбирает план. Создаётся Subscription в состоянии pending и ссылка на оплату.",
  },
  {
    state: "pay",
    title: "Оплата",
    text: "Платёжный адаптер возвращает счёт или ссылку. Провайдер спрятан за портом.",
  },
  {
    state: "active",
    title: "Подтверждение",
    text: "Вебхук или демо-шлюз подтверждает платёж. Подписка переходит в active, появляется AccessGrant.",
  },
  {
    state: "join",
    title: "Доступ",
    text: "Заявка на вступление одобряется только при активной подписке. Ссылку нельзя переслать и обойти.",
  },
  {
    state: "expired",
    title: "Истечение",
    text: "Команда revokeExpiredSubscriptionsCommand находит просроченные подписки, отзывает AccessGrant и снимает доступ через banChatMember. Запуск — по cron или вручную.",
  },
];

const features = [
  {
    kicker: "01 / payments",
    title: "Пять адаптеров и Telegram Stars",
    text: "Stripe, ЮKassa, Robokassa, Prodamus и mock. Отдельный адаптер Telegram Stars. Один порт, разные протоколы и подписи вебхуков.",
  },
  {
    kicker: "02 / access",
    title: "Доступ по заявке",
    text: "Не обычная invite-ссылка, а join request: бот проверяет активную подписку в базе и только потом одобряет вход.",
  },
  {
    kicker: "03 / lifecycle",
    title: "Истечение по сроку",
    text: "Команда для cron или ручного запуска: находит подписки с истёкшим сроком, отзывает AccessGrant и снимает доступ из канала через banChatMember.",
  },
  {
    kicker: "04 / content",
    title: "Редактор шаблонов",
    text: "Админ меняет тексты из бота. Плейсхолдеры вроде {{expiresAt}} подставляются в момент отправки, HTML разрешён.",
  },
  {
    kicker: "05 / checkout",
    title: "Оплата в Mini App",
    text: "Демо-шлюз открывается внутри Telegram: выбор плана, карточка, успешная оплата и возврат в бота.",
  },
  {
    kicker: "06 / admin",
    title: "Админский контур",
    text: "Создание плана, готовая ссылка, рекламный пост и список активных подписок — без отдельной панели.",
  },
];

const numbers = [
  { value: "4", label: "доменных теста", note: "18 assertions" },
  { value: "5 + 1", label: "платёжный адаптер", note: "плюс Telegram Stars" },
  { value: "7 + 5", label: "commands + queries", note: "CQRS" },
  { value: "17", label: "адаптеров", note: "SQLite, Postgres, Telegram" },
];

const limits = [
  {
    title: "Демо-платежи",
    text: "По умолчанию работает mock-провайдер и локальный шлюз. Боевые ключи, подписи и вебхуки подключаются через адаптеры, но не входят в демо.",
  },
  {
    title: "Четыре теста",
    text: "Тесты покрывают доменный сценарий подписки: создание, оплату, истечение и ручной отзыв. End-to-end через Telegram API не автоматизирован.",
  },
  {
    title: "Планировщик",
    text: "Команда истечения есть, но cron в поставку не входит: её нужно повесить на планировщик или вызывать вручную.",
  },
  {
    title: "Только Telegram",
    text: "AccessGrant уже описывает ресурс и тип, но Discord, веб-портал и бандлы — это следующий слой, а не текущая поставка.",
  },
  {
    title: "Хранилище",
    text: "По умолчанию нужен Postgres; без DATABASE_URL сервис работает без состояния. SQLite включается через DATABASE_TYPE=sqlite и SQLITE_PATH.",
  },
  {
    title: "Без метрик",
    text: "Это инфраструктура и демо-стенд, а не боевая инсталляция. Конверсии, выручки и числа подписчиков здесь нет.",
  },
];
---

<BaseLayout
  title="TG Paywall — кейс: платная подписка на Telegram-канал"
  description="Разбор TG Paywall: жизненный цикл подписки, доступ по заявке, авто-истечение, шесть платёжных адаптеров и оплата в Mini App."
>
  <Header />

  <main id="main">
    <article class="case">
      <header class="case-hero">
        <div class="wrap case-hero-inner">
          <a class="case-back mono" href={`${base}#projects`}>
            <span aria-hidden="true">←</span> все проекты
          </a>

          <div class="case-kicker mono">
            <span>Кейс / Telegram</span>
            <span>2026</span>
          </div>

          <h1 class="case-title">
            Платный доступ,<br />
            который закрывается сам.
          </h1>

          <p class="case-lede">
            TG Paywall — open-source инфраструктура подписки на закрытый канал.
            Бот принимает оплату, выдаёт доступ через заявку и снимает его,
            когда срок закончился. Типичный заказ для ботодела, собранный как
            домен, а не как набор обработчиков.
          </p>

          <dl class="case-meta">
            <div>
              <dt>Роль</dt>
              <dd>Архитектура, домен, бот, TMA-демо</dd>
            </div>
            <div>
              <dt>Стек</dt>
              <dd>TypeScript · Bun · grammY · SQLite / Postgres</dd>
            </div>
            <div>
              <dt>Статус</dt>
              <dd>Open source · демо-платежи</dd>
            </div>
            <div>
              <dt>Лицензия</dt>
              <dd>MIT</dd>
            </div>
          </dl>

          <div class="case-actions">
            <a class="case-button" href={repo} target="_blank" rel="noopener noreferrer">
              Смотреть код <span aria-hidden="true">↗</span>
            </a>
            <a class="case-text-link mono" href={mailto}>
              обсудить похожий сценарий <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </header>

      <div class="case-hero-shot">
        <div class="wrap">
          <figure class="hero-figure">
            <img
              src={img("02-plans.jpg")}
              alt="Экран выбора тарифа в Telegram: Career Accelerator за 2990 рублей и Lifetime Legend за 14990 рублей"
              width="576"
              height="1280"
              loading="eager"
              decoding="async"
            />
            <figcaption class="mono">
              Демо-бот: два формата участия, оплата внутри Telegram
            </figcaption>
          </figure>
        </div>
      </div>

      <section class="case-section wrap" aria-labelledby="task">
        <div class="case-section-head">
          <p class="mono case-label">01 / задача</p>
          <h2 id="task">Подписка — это не кнопка «Оплатить».</h2>
        </div>

        <div class="task-grid">
          <blockquote class="task-quote">
            «Оплатил» — начало работы. Настоящая задача — удержать вместе
            состояние, срок и доступ, когда человек уже ушёл из бота.
          </blockquote>

          <div class="task-copy">
            <p>
              Эксперт продаёт доступ в закрытый канал. В ручном режиме нужно
              проверять чеки, добавлять людей, помнить даты и удалять тех, у
              кого подписка закончилась.
            </p>
            <p>
              Ошибка в любую сторону стоит денег: пустил без оплаты — потерял
              выручку; забыл удалить — потерял контроль над контентом.
            </p>
            <p>
              Поэтому сценарий заканчивается не сообщением «оплачено», а
              состоянием <code>active</code> и записью <code>AccessGrant</code>,
              которую потом можно отозвать.
            </p>
          </div>
        </div>
      </section>

      <section class="case-section case-section-tint" aria-labelledby="flow">
        <div class="wrap">
          <div class="case-section-head">
            <p class="mono case-label">02 / сценарий</p>
            <h2 id="flow">Шесть шагов от тарифа до удаления.</h2>
          </div>

          <ol class="flow-list">
            {flow.map((step, index) => (
              <li class="flow-step">
                <div class="flow-top">
                  <span class="flow-num mono">{String(index + 1).padStart(2, "0")}</span>
                  <code class="flow-state">{step.state}</code>
                </div>
                <h3>{step.title}</h3>
                <p>{step.text}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <section class="case-section wrap" aria-labelledby="inside">
        <div class="case-section-head">
          <p class="mono case-label">03 / что внутри</p>
          <h2 id="inside">Не бот с кнопками, а инфраструктура доступа.</h2>
        </div>

        <div class="feature-grid">
          {features.map((feature) => (
            <article class="feature">
              <p class="mono feature-kicker">{feature.kicker}</p>
              <h3>{feature.title}</h3>
              <p>{feature.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="case-section case-section-ink" aria-labelledby="architecture">
        <div class="wrap">
          <div class="case-section-head">
            <p class="mono case-label">04 / архитектура</p>
            <h2 id="architecture">Домен не знает, что такое Telegram.</h2>
          </div>

          <p class="arch-lede">
            Порты и адаптеры: платёжный провайдер, база и Telegram подключаются
            снаружи. Внутри — агрегаты с инвариантами и use cases, которые
            можно проверить без сети.
          </p>

          <div class="arch-diagram" aria-label="Слои архитектуры">
            <div class="arch-row">
              <p class="arch-label mono">driving</p>
              <div class="arch-items">
                <span>grammY bot</span>
                <span>webhook server</span>
                <span>TMA demo</span>
              </div>
            </div>
            <div class="arch-row">
              <p class="arch-label mono">application</p>
              <div class="arch-items">
                <span>7 commands</span>
                <span>5 queries</span>
                <span>7 features</span>
              </div>
            </div>
            <div class="arch-row arch-row-domain">
              <p class="arch-label mono">domain</p>
              <div class="arch-items">
                <span>Plan</span>
                <span>Subscription</span>
                <span>AccessGrant</span>
              </div>
            </div>
            <div class="arch-row">
              <p class="arch-label mono">driven</p>
              <div class="arch-items">
                <span>SQLite</span>
                <span>Postgres</span>
                <span>Telegram API</span>
                <span>payments</span>
              </div>
            </div>
          </div>

          <div class="arch-notes">
            <div>
              <h3>Смена платежки — одна строка</h3>
              <p>
                Провайдер выбирается в composition root. Домен и сценарий
                подписки остаются прежними, меняется только адаптер.
              </p>
            </div>
            <div>
              <h3>Тесты без базы и сети</h3>
              <p>
                Доменный сценарий проверяется на in-memory адаптерах: создать
                план, оплатить, дождаться истечения, отозвать доступ.
              </p>
            </div>
            <div>
              <h3>Доступ как сущность</h3>
              <p>
                <code>AccessGrant</code> связывает пользователя, ресурс и
                подписку. Поэтому доступ можно выдавать, отзывать и расширять
                на несколько ресурсов.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="case-section wrap" aria-labelledby="screens">
        <div class="case-section-head">
          <p class="mono case-label">05 / экраны</p>
          <h2 id="screens">Путь от приветствия до активной подписки.</h2>
        </div>

        <div class="screen-grid">
          <figure class="screen">
            <img
              src={img("01-welcome.jpg")}
              alt="Приветствие бота с кнопками Premium Membership, Участие (Legacy) и Мой статус"
              width="576"
              height="1280"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="mono">01</span>
              Вход: приветствие, форматы участия и статус.
            </figcaption>
          </figure>

          <figure class="screen">
            <img
              src={img("03-tma.jpg")}
              alt="Оплата в Telegram Mini App: два тарифа и кнопка Продолжить за 2990 рублей"
              width="576"
              height="1280"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="mono">02</span>
              Checkout в Mini App, без перехода в браузер.
            </figcaption>
          </figure>

          <figure class="screen">
            <img
              src={img("05-active.jpg")}
              alt="Сообщение об успешной оплате: доступ активирован до 29 апреля 2026 и кнопка Вступить в канал"
              width="576"
              height="1280"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="mono">03</span>
              Подписка активна, доступ выдан до конкретной даты.
            </figcaption>
          </figure>

          <figure class="screen">
            <img
              src={img("06-template.jpg")}
              alt="Редактор шаблона payment_confirmed в боте: текущий текст с переменной expiresAt и инструкция"
              width="576"
              height="1280"
              loading="lazy"
              decoding="async"
            />
            <figcaption>
              <span class="mono">04</span>
              Админ правит текст сообщения прямо в боте.
            </figcaption>
          </figure>
        </div>
      </section>

      <section class="case-section case-section-tint" aria-labelledby="facts">
        <div class="wrap">
          <div class="case-section-head">
            <p class="mono case-label">06 / что проверяемо</p>
            <h2 id="facts">Цифры из репозитория, не из презентации.</h2>
          </div>

          <div class="numbers">
            {numbers.map((number) => (
              <div class="number">
                <p class="number-value">{number.value}</p>
                <p class="number-label">{number.label}</p>
                <p class="number-note mono">{number.note}</p>
              </div>
            ))}
          </div>

          <ul class="check-list">
            <li>Доменные тесты запускаются командой <code>bun test</code> на in-memory адаптерах.</li>
            <li>Сценарий не зависит от хранилища: есть адаптеры SQLite и Postgres.</li>
            <li>Вебхуки пяти провайдеров сведены к одному use case подтверждения оплаты; Telegram Stars — отдельный адаптер.</li>
            <li>Шаблоны сообщений хранятся в базе и переопределяются без деплоя.</li>
            <li>В репозитории есть README, быстрый старт и схема архитектуры.</li>
          </ul>
        </div>
      </section>

      <section class="case-section wrap" aria-labelledby="limits">
        <div class="case-section-head">
          <p class="mono case-label">07 / границы</p>
          <h2 id="limits">Что этот кейс не обещает.</h2>
        </div>

        <div class="limit-grid">
          {limits.map((limit) => (
            <article class="limit">
              <h3>{limit.title}</h3>
              <p>{limit.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="case-cta">
        <div class="wrap case-cta-inner">
          <div>
            <p class="mono case-label">Дальше</p>
            <h2>Нужен платный доступ, подписка или похожий жизненный цикл?</h2>
          </div>
          <div class="case-cta-actions">
            <a class="case-button case-button-light" href={mailto}>
              Написать <span aria-hidden="true">↗</span>
            </a>
            <a class="case-text-link mono" href={repo} target="_blank" rel="noopener noreferrer">
              открыть репозиторий <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .case {
    --case-gutter: clamp(20px, 4vw, 56px);
  }

  .case-hero {
    border-bottom: 1px solid var(--line);
  }

  .case-hero-inner {
    padding-block: clamp(28px, 4vw, 56px) clamp(40px, 6vw, 76px);
  }

  .case-back {
    display: inline-flex;
    gap: 8px;
    margin-bottom: clamp(40px, 6vw, 72px);
    color: var(--muted);
    transition: color 160ms var(--ease);
  }

  .case-back:hover {
    color: var(--signal-text);
  }

  .case-kicker {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .case-title {
    max-width: 15ch;
    margin-top: clamp(26px, 4vw, 44px);
    font-family: var(--serif);
    font-size: clamp(48px, 8.2vw, 112px);
    font-weight: 500;
    line-height: 0.92;
    letter-spacing: -0.05em;
  }

  .case-lede {
    max-width: 58ch;
    margin-top: clamp(26px, 3.5vw, 40px);
    color: var(--ink-2);
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.45;
  }

  .case-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }

  .case-meta div {
    padding: 14px 18px 0;
    border-left: 1px solid var(--line);
  }

  .case-meta div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .case-meta dt {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .case-meta dd {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.4;
  }

  .case-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 28px;
    margin-top: 30px;
  }

  .case-button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 13px 18px;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    transition: background 180ms var(--ease), color 180ms var(--ease);
  }

  .case-button:hover {
    background: var(--signal-text);
    color: var(--paper);
  }

  .case-text-link {
    color: var(--muted);
    transition: color 160ms var(--ease);
  }

  .case-text-link:hover {
    color: var(--signal-text);
  }

  .case-hero-shot {
    padding-block: clamp(36px, 5vw, 64px);
    background: var(--tint-signal);
    border-bottom: 1px solid var(--line);
  }

  .hero-figure {
    display: grid;
    justify-items: center;
    gap: 16px;
  }

  .hero-figure img {
    width: auto;
    max-height: min(72vh, 760px);
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .hero-figure figcaption {
    color: var(--muted);
  }

  .case-section {
    padding-block: clamp(64px, 9vw, 124px);
    border-bottom: 1px solid var(--line);
  }

  .case-section-tint {
    background: var(--paper-2);
  }

  .case-section-ink {
    background: var(--ink);
    color: var(--paper);
    border-bottom: 0;
  }

  .case-section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 20px 48px;
    margin-bottom: clamp(36px, 5vw, 64px);
  }

  .case-label {
    grid-column: 1 / -1;
    padding-bottom: 12px;
    border-bottom: 1px solid currentColor;
    color: var(--faint);
  }

  .case-section-ink .case-label {
    color: oklch(0.64 0.01 82);
    border-color: oklch(0.33 0.012 75);
  }

  .case-section-head h2 {
    max-width: 24ch;
    font-family: var(--serif);
    font-size: clamp(34px, 6.4vw, 68px);
    font-weight: 500;
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .task-grid {
