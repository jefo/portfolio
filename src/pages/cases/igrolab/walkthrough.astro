---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { site } from "../../../data/site";

const base = import.meta.env.BASE_URL;
const img = (name: string) => `${base}shots/${name}`;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent("AI Content Ops: walkthrough")}`;

const steps = [
  { n: "01", label: "Сбор", short: "Один вход" },
  { n: "02", label: "Проверка", short: "Паспорт цифры" },
  { n: "03", label: "Анализ", short: "Записка" },
  { n: "04", label: "Сценарий", short: "Задание автору" },
  { n: "05", label: "Текст", short: "Голос" },
  { n: "06", label: "Страница", short: "Сборка" },
  { n: "07", label: "Обновление", short: "Сигнал" },
];

const beforeAfter = [
  {
    step: "Сбор",
    before: "Дни чтения обзоров",
    after: "Один вход: спека, обзоры, цены",
    human: "Проверяет, что не потеряно",
  },
  {
    step: "Проверка",
    before: "На глаз",
    after: "Паспорт каждой цифры",
    human: "Решает, какие оценки допустимы",
  },
  {
    step: "Анализ",
    before: "В голове, не воспроизводим",
    after: "Записка: ограничение, компромисс, вывод",
    human: "Валидирует выводы",
  },
  {
    step: "Сценарий",
    before: "С нуля",
    after: "Задание: до / после / путь / тон",
    human: "Утверждает",
  },
  {
    step: "Текст",
    before: "С нуля",
    after: "Фактура и структура",
    human: "Пишет голосом",
  },
  {
    step: "Страница",
    before: "Рисуется с нуля",
    after: "Собирается из системы",
    human: "Вычитывает",
  },
  {
    step: "Обновление",
    before: "Вручную",
    after: "Сигнал: драйвер, цена, конкурент",
    human: "Решает приоритет",
  },
];

const gives = [
  {
    title: "Быстрее",
    text: "Меньше рутины на входе: сбор, сведение, проверка.",
  },
  {
    title: "Повторяемо",
    text: "Один процесс на все материалы, а не «как получится».",
  },
  {
    title: "Доверчивее",
    text: "У каждой цифры есть источник, дата и степень уверенности.",
  },
  {
    title: "Переиспользуемо",
    text: "Знание живёт дольше одной статьи: обзор, сравнение, стоимость владения.",
  },
];

const human = [
  {
    title: "Голос",
    text: "Система не пишет так, как пишет автор. Финальный текст — за ним.",
  },
  {
    title: "Решение",
    text: "Что важно, что спорно, что не стоит публиковать.",
  },
  {
    title: "Отношения",
    text: "С экспертами, читателями и рынком. Это не автоматизируется.",
  },
];

const limits = [
  {
    title: "Не лаборатория",
    text: "Если нужны собственные замеры — это отдельный стенд, а не контент-система.",
  },
  {
    title: "Не пишет голос",
    text: "LLM даёт фактуру и структуру. Живой текст появляется после автора.",
  },
  {
    title: "Не работает без данных",
    text: "Нет источника — нет факта. Нет факта — нет вывода. Система не заполняет дыры вымыслом.",
  },
];

const start = [
  {
    n: "01",
    title: "Аудит 3 материалов",
    text: "Смотрим, где теряется время, какие факты не проверяются и что можно переиспользовать.",
  },
  {
    n: "02",
    title: "Пилот на 1–3 материалах",
    text: "Проходим полный цикл и замеряем время, ошибки и количество правок.",
  },
  {
    n: "03",
    title: "Внедрение",
    text: "Фиксируем процесс, роли и инструменты. Обучаем редакцию.",
  },
];
---

<BaseLayout
  title="Walkthrough — как один материал проходит через редакцию"
  description="Путь одного материала от сырья до публикации: сбор, проверка, анализ, сценарий, текст, страница, обновление. RX 9050 как пример."
>
  <Header />

  <main id="main">
    <article class="walk">
      <header class="walk-hero">
        <div class="wrap">
          <a class="walk-back mono" href={`${base}cases/igrolab/`}>
            <span aria-hidden="true">←</span> к кейсу
          </a>

          <div class="walk-kicker mono">
            <span>Walkthrough / AI Content Ops</span>
            <span>2026</span>
          </div>

          <h1 class="walk-title">
            Как один материал<br />
            проходит через редакцию.
          </h1>

          <p class="walk-lede">
            RX 9050 — пример. Речь о процессе, который можно перенести на любой
            экспертный сайт: меньше рутины, больше авторской работы.
          </p>

          <dl class="walk-meta">
            <div>
              <dt>Объект</dt>
              <dd>Radeon RX 9050</dd>
            </div>
            <div>
              <dt>Вход</dt>
              <dd>1 спека · 3 обзора</dd>
            </div>
            <div>
              <dt>Выход</dt>
              <dd>Записка · статья</dd>
            </div>
            <div>
              <dt>Роль</dt>
              <dd>Редакция · система</dd>
            </div>
          </dl>
        </div>
      </header>

      <div class="walk-strip">
        <div class="wrap">
          <ol>
            {steps.map((step) => (
              <li>
                <span class="mono">{step.n}</span>
                <strong>{step.label}</strong>
                <em>{step.short}</em>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <section class="step wrap" aria-labelledby="s1">
        <aside class="step-side">
          <div class="step-num">01</div>
          <div class="step-label mono">Сбор</div>
          <div class="step-roles">
            <span>Система</span>
            <span>Человек</span>
          </div>
        </aside>
        <div class="step-body">
          <h2 id="s1">Из десяти источников — один вход.</h2>
          <p>
            Автор больше не читает всё подряд. Система собирает спеку, обзоры и
            цены в одну карточку: что известно, откуда и насколько свежо.
          </p>

          <div class="card">
            <div class="card-head mono">
              <span>Карточка продукта</span>
              <span>собрано</span>
            </div>
            <div class="card-row">
              <span>Radeon RX 9050</span>
              <span class="mono">92 W · 8 GB · $279</span>
            </div>
            <div class="card-row">
              <span>Источники</span>
              <span class="mono">1 спека + 3 обзора</span>
            </div>
            <div class="card-row">
              <span>Статус</span>
              <span class="mono">собрано</span>
            </div>
          </div>

          <p class="human-line">
            <strong>Человек:</strong> проверяет, что ничего важного не потеряно.
          </p>
          <ul class="gates">
            <li>Проверка: обязательные поля, источники, дубли.</li>
          </ul>
        </div>
      </section>

      <section class="step step-tint" aria-labelledby="s2">
        <div class="wrap step-grid">
          <aside class="step-side">
            <div class="step-num">02</div>
            <div class="step-label mono">Проверка</div>
            <div class="step-roles">
              <span>Система</span>
              <span>Человек</span>
            </div>
          </aside>
          <div class="step-body">
            <h2 id="s2">У каждой цифры есть паспорт.</h2>
            <p>
              Система показывает не только цифру, но и её происхождение. Это не
              «доверьтесь AI» — это «вот источник, дата и степень уверенности».
            </p>

            <div class="check-table">
              <div class="check-row check-head mono">
                <span>Цифра</span>
                <span>Откуда</span>
                <span>Когда</span>
                <span>Статус</span>
              </div>
              <div class="check-row">
                <span>92 W</span>
                <span>спека</span>
                <span>июль</span>
                <span class="ok">подтверждено</span>
              </div>
              <div class="check-row">
                <span>8 GB</span>
                <span>спека</span>
                <span>июль</span>
                <span class="ok">подтверждено</span>
              </div>
              <div class="check-row">
                <span>FPS</span>
                <span>обзор</span>
                <span>июль</span>
                <span class="warn">оценка</span>
              </div>
              <div class="check-row">
                <span>Цена</span>
                <span>price.ru</span>
                <span>июль</span>
                <span class="ok">подтверждено</span>
              </div>
            </div>

            <p class="human-line">
              <strong>Человек:</strong> решает, какие оценки допустимы в тексте.
            </p>
            <ul class="gates">
              <li>Проверка: нет источника — нет цифры.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="step wrap" aria-labelledby="s3">
        <aside class="step-side">
          <div class="step-num">03</div>
          <div class="step-label mono">Анализ</div>
          <div class="step-roles">
            <span>Система</span>
            <span>Человек</span>
          </div>
        </aside>
        <div class="step-body">
          <h2 id="s3">Вместо таблицы — записка.</h2>
          <p>
            Система собирает не «характеристики», а инженерную записку: главное
            ограничение, компромиссы, что невозможно и почему.
          </p>

          <div class="card">
            <div class="card-head mono">
              <span>Аналитическая записка</span>
              <span>4 вывода</span>
            </div>
            <ul class="note-list">
              <li><span>Ограничение</span> 92 W — не компромисс, а принцип</li>
              <li><span>Следствие</span> размер, цена, аудитория</li>
              <li><span>Невозможно</span> 16 GB без другого продукта</li>
              <li><span>Значит</span> SFF-инструмент, а не «слабая карта»</li>
            </ul>
          </div>

          <blockquote>
            «16 GB потребовали бы другой платы и другого продукта — это не
            жадность, а физика».
            <cite>из аналитической записки</cite>
          </blockquote>

          <p class="human-line">
            <strong>Человек:</strong> эксперт валидирует выводы.
          </p>
          <ul class="gates">
            <li>Проверка: каждый вывод связан с фактом.</li>
          </ul>
        </div>
      </section>

      <section class="step step-tint" aria-labelledby="s4">
        <div class="wrap step-grid">
          <aside class="step-side">
            <div class="step-num">04</div>
            <div class="step-label mono">Сценарий</div>
            <div class="step-roles">
              <span>Система</span>
              <span>Человек</span>
            </div>
          </aside>
          <div class="step-body">
            <h2 id="s4">Вместо «напиши статью» — задание.</h2>
            <p>
              Система формулирует, что читатель думает до, что должен понять
              после и каким путём. Автор не гадает, с чего начать.
            </p>

            <div class="card">
              <div class="card-head mono">
                <span>Задание автору</span>
                <span>сценарий</span>
              </div>
              <ul class="note-list">
                <li><span>До</span> «слабая карта — плохая покупка»</li>
                <li><span>После</span> «92 W — принцип SFF-продукта»</li>
                <li><span>Путь</span> сомнение → факты → переворот → вывод</li>
                <li><span>Тон</span> без вердикта</li>
              </ul>
            </div>

            <p class="human-line">
              <strong>Человек:</strong> редактор утверждает сценарий.
            </p>
            <ul class="gates">
              <li>Проверка: сценарий не противоречит фактам и логике.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="step wrap" aria-labelledby="s5">
        <aside class="step-side">
          <div class="step-num">05</div>
          <div class="step-label mono">Текст</div>
          <div class="step-roles">
            <span>Человек</span>
          </div>
        </aside>
        <div class="step-body">
          <h2 id="s5">Автор пишет голосом.</h2>
          <p>
            Система не пишет финальный текст. Она даёт проверенные факты,
            структуру и задание. Автор пишет так, как умеет только он.
          </p>

          <blockquote class="big-quote">
            «Не смотрите на 16 CU.<br />
            Смотрите на 92 W.»
            <cite>авторская формулировка, выросшая из записки</cite>
          </blockquote>

          <p class="human-line">
            <strong>Человек:</strong> пишет.
          </p>
          <ul class="gates">
            <li>Проверка: факты не разошлись с источниками.</li>
          </ul>
        </div>
      </section>

      <section class="step step-tint" aria-labelledby="s6">
        <div class="wrap step-grid">
          <aside class="step-side">
            <div class="step-num">06</div>
            <div class="step-label mono">Страница</div>
            <div class="step-roles">
              <span>Система</span>
              <span>Человек</span>
            </div>
          </aside>
          <div class="step-body">
            <h2 id="s6">Дизайн собирается из системы.</h2>
            <p>
              Страница не рисуется с нуля: 14 типов страниц, готовые блоки,
              цвета достоверности. Дизайн помогает читателю видеть, где факт,
              где оценка, где вывод.
            </p>

            <figure class="shot">
              <img
                src={img("igrolab-rx9050.webp")}
                alt="Страница обзора Radeon RX 9050: тёмный инженерный лонгрид с заголовком «92W»"
                width="1440"
                height="900"
                loading="lazy"
              />
              <figcaption class="mono">/gpu/radeon-rx-9050-review/</figcaption>
            </figure>

            <p class="human-line">
              <strong>Человек:</strong> финальная вычитка.
            </p>
            <ul class="gates">
              <li>Проверка: сборка, ссылки, читаемость.</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="step wrap" aria-labelledby="s7">
        <aside class="step-side">
          <div class="step-num">07</div>
          <div class="step-label mono">Обновление</div>
          <div class="step-roles">
            <span>Система</span>
            <span>Человек</span>
          </div>
        </aside>
        <div class="step-body">
          <h2 id="s7">Материал говорит, когда устарел.</h2>
          <p>
            Новый драйвер, новая цена, новый конкурент — система помечает
            материал и предлагает обновить. Редакция не держит это в голове.
          </p>

          <div class="card">
            <div class="card-head mono">
              <span>Что делает материал устаревшим</span>
              <span>сигнал</span>
            </div>
            <ul class="note-list">
              <li><span>Драйвер</span> новая версия</li>
              <li><span>Цена</span> изменилась</li>
              <li><span>Конкурент</span> вышел новый продукт</li>
              <li><span>Методика</span> обновилась</li>
            </ul>
          </div>

          <p class="human-line">
            <strong>Человек:</strong> решает, что обновлять сейчас.
          </p>
          <ul class="gates">
            <li>Проверка: свежесть и полнота.</li>
          </ul>
        </div>
      </section>

      <section class="section wrap" aria-labelledby="before-after">
        <div class="section-head">
          <div class="section-label mono">08 / было / стало</div>
          <h2 id="before-after">Что изменилось в работе редакции.</h2>
        </div>

        <div class="ba-table">
          <div class="ba-row ba-head mono">
            <span>Шаг</span>
            <span>Было</span>
            <span>Стало</span>
            <span>Человек</span>
          </div>
          {beforeAfter.map((row) => (
            <div class="ba-row">
              <span class="ba-step">{row.step}</span>
              <span>{row.before}</span>
              <span>{row.after}</span>
              <span>{row.human}</span>
            </div>
          ))}
        </div>

        <p class="section-note">
          Система убирает <strong>первый проход</strong>: сбор, сведение,
          проверку, поиск противоречий. Она не убирает <strong>последний</strong>:
          голос, решение, ответственность.
        </p>
      </section>

      <section class="section section-tint" aria-labelledby="gives">
        <div class="wrap">
          <div class="section-head">
            <div class="section-label mono">09 / что это даёт</div>
            <h2 id="gives">Четыре вещи, которые меняются для редакции.</h2>
          </div>

          <div class="grid-4">
            {gives.map((item) => (
              <article class="cell">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section wrap" aria-labelledby="human">
        <div class="section-head">
          <div class="section-label mono">10 / что остаётся человеку</div>
          <h2 id="human">То, что не автоматизируется.</h2>
        </div>

        <div class="grid-3">
          {human.map((item) => (
            <article class="cell">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="section section-tint" aria-labelledby="limits">
        <div class="wrap">
          <div class="section-head">
            <div class="section-label mono">11 / чего это не делает</div>
            <h2 id="limits">Границы, которые лучше назвать сразу.</h2>
          </div>

          <div class="grid-3">
            {limits.map((item) => (
              <article class="cell">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section wrap" aria-labelledby="start">
        <div class="section-head">
          <div class="section-label mono">12 / как начать</div>
          <h2 id="start">Не «написать 100 статей». Три шага.</h2>
        </div>

        <ol class="start-list">
          {start.map((item) => (
            <li>
              <span class="start-num mono">{item.n}</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.text}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="walk-cta">
        <div class="wrap walk-cta-inner">
          <div>
            <div class="mono">AI Content Ops</div>
            <h2>Хочешь такой процесс для своего сайта?</h2>
          </div>
          <div class="walk-cta-actions">
            <a class="walk-button" href={mailto}>
              Обсудить <span aria-hidden="true">↗</span>
            </a>
            <a class="walk-text-link mono" href={`${base}cases/igrolab/`}>
              вернуться к кейсу
            </a>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .walk-hero {
    border-bottom: 1px solid var(--line);
  }

  .walk-hero .wrap {
    padding-block: clamp(28px, 4vw, 56px) clamp(40px, 6vw, 76px);
  }

  .walk-back {
    display: inline-flex;
    gap: 8px;
    margin-bottom: clamp(40px, 6vw, 72px);
    color: var(--muted);
    transition: color 160ms var(--ease);
  }

  .walk-back:hover {
    color: var(--signal-text);
  }

  .walk-kicker {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .walk-title {
    max-width: 20ch;
    margin-top: clamp(26px, 4vw, 44px);
    font-family: var(--serif);
    font-size: clamp(42px, 6.8vw, 94px);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.05em;
  }

  .walk-lede {
    max-width: 58ch;
    margin-top: clamp(26px, 3.5vw, 40px);
    color: var(--ink-2);
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.45;
  }

  .walk-meta {
    display: grid;
