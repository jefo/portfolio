---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { site } from "../../../data/site";

const base = import.meta.env.BASE_URL;
const img = (name: string) => `${base}shots/${name}`;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent("AI Content Ops: walkthrough")}`;

const steps = [
  { n: "01", label: "Intake", short: "Сырьё → структура" },
  { n: "02", label: "Warehouse", short: "Один факт → много страниц" },
  { n: "03", label: "Analysis", short: "IRV вместо таблицы" },
  { n: "04", label: "Narrative", short: "Анализ → траектория" },
  { n: "05", label: "Brief", short: "Компиляция, не вдохновение" },
  { n: "06", label: "Render", short: "Страница как сборка" },
  { n: "07", label: "Feedback", short: "Материал не заканчивается" },
];

const beforeAfter = [
  {
    step: "Сбор",
    manual: "2–3 дня чтения (оценка)",
    system: "Агент извлекает и нормализует",
    human: "Утверждает спорное",
  },
  {
    step: "Таблица",
    manual: "Руками, быстро устаревает",
    system: "DWH: одна запись на факт",
    human: "—",
  },
  {
    step: "Анализ",
    manual: "В голове, не воспроизводим",
    system: "IRV + lineage",
    human: "Валидирует assumptions",
  },
  {
    step: "Текст",
    manual: "С нуля",
    system: "NAM → brief → prose",
    human: "Голос и финал",
  },
  {
    step: "QA",
    manual: "Выборочно",
    system: "52/52 или hold",
    human: "Решает, что делать с WARN",
  },
  {
    step: "Переиспользование",
    manual: "Копипаста",
    system: "Один факт → много страниц",
    human: "—",
  },
  {
    step: "Обновление",
    manual: "Вручную",
    system: "Stale detection",
    human: "Решает приоритет",
  },
];

const limits = [
  {
    title: "Не измеряет",
    text: "Это не лаборатория. FPS — из открытых источников; проекции помечены как проекции.",
  },
  {
    title: "Не пишет голос",
    text: "LLM даёт скелет и фактуру. Живой текст появляется после редактора.",
  },
  {
    title: "Не работает без данных",
    text: "Нет источника — нет факта. Нет факта — нет вывода. Система не заполняет дыры вымыслом.",
  },
];
---

<BaseLayout
  title="Walkthrough — один цикл контент-фабрики"
  description="Как из одной спеки и трёх обзоров получается инженерный бриф и страница: DWH, IRV, NAM, QA, render. RX 9050 как иллюстрация."
>
  <Header />

  <main id="main">
    <article class="walk">
      <header class="walk-hero">
        <div class="wrap">
          <a class="walk-back mono" href={`${base}cases/igrolab/`}>
            <span aria-hidden="true">←</span> к кейсу
          </a>

          <div class="walk-kicker mono">
            <span>Walkthrough / AI Content Ops</span>
            <span>2026</span>
          </div>

          <h1 class="walk-title">
            Один цикл:<br />
            от спеки до страницы.
          </h1>

          <p class="walk-lede">
            Radeon RX 9050 — только иллюстрация. Важно, что на каждом шаге
            появляется артефакт, кто его проверяет и что остаётся человеку.
          </p>

          <dl class="walk-meta">
            <div>
              <dt>Объект</dt>
              <dd>Radeon RX 9050</dd>
            </div>
            <div>
              <dt>Вход</dt>
              <dd>1 спека · 3 обзора</dd>
            </div>
            <div>
              <dt>Выход</dt>
              <dd>IRV · NAM · страница</dd>
            </div>
            <div>
              <dt>Роль</dt>
              <dd>DWH · редактура · дизайн</dd>
            </div>
          </dl>
        </div>
      </header>

      <div class="walk-strip">
        <div class="wrap">
          <ol>
            {steps.map((step) => (
              <li>
                <span class="mono">{step.n}</span>
                <strong>{step.label}</strong>
                <em>{step.short}</em>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <section class="walk-step wrap" aria-labelledby="s1">
        <aside class="step-meta">
          <div class="step-num">01</div>
          <div class="step-label mono">Intake</div>
          <div class="step-roles">
            <span>AI</span>
            <span>Human</span>
          </div>
        </aside>
        <div class="step-body">
          <h2 id="s1">Агент раскладывает сырьё в структуру.</h2>
          <p>
            Из спеки и трёх обзоров появляется dimension, 20 наблюдений и
            provenance. Не «текст», а данные, с которыми можно работать.
          </p>

          <div class="artifact">
            <div class="artifact-head mono">
              <span>artifact</span>
              <span>dim + facts</span>
            </div>
            <pre><code>dimension: amd-radeon-rx-9050
attributes:
  tdp_w: 92
  vram_gb: 8
  msrp_usd: 279
facts: 20
confidence: 0.45–0.90
source_url: ...</code></pre>
          </div>

          <ul class="gates">
            <li><span class="mono">gate</span> fact-insert: mandatory dims, allowed measures, dedupe, provenance</li>
          </ul>
          <p class="hardware-note">
            Деталь железа: 92 W, 8 GB, $279. Дальше не углубляемся.
          </p>
        </div>
      </section>

      <section class="walk-step walk-step-tint" aria-labelledby="s2">
        <div class="wrap step-grid">
          <aside class="step-meta">
            <div class="step-num">02</div>
            <div class="step-label mono">Warehouse</div>
            <div class="step-roles">
              <span>AI</span>
            </div>
          </aside>
          <div class="step-body">
            <h2 id="s2">Один факт — много страниц.</h2>
            <p>
              Факт больше не принадлежит одной статье. Он доступен обзору,
              сравнению, TCO, lifecycle и coverage.
            </p>

            <div class="artifact artifact-map">
              <div class="map-root mono">fact</div>
              <div class="map-lines" aria-hidden="true"></div>
              <ul>
                <li>review</li>
                <li>compare</li>
                <li>TCO</li>
                <li>lifecycle</li>
                <li>coverage</li>
              </ul>
            </div>

            <ul class="gates">
              <li><span class="mono">gate</span> bus matrix + context map</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="walk-step wrap" aria-labelledby="s3">
        <aside class="step-meta">
          <div class="step-num">03</div>
          <div class="step-label mono">Analysis</div>
          <div class="step-roles">
            <span>AI</span>
            <span>Human</span>
          </div>
        </aside>
        <div class="step-body">
          <h2 id="s3">IRV: инженерный бриф вместо таблицы.</h2>
          <p>
            Система собирает hypothesis, constraint hierarchy, design space,
            decisions и consequences. Не «что в спеке», а «почему продукт такой».
          </p>

          <div class="artifact artifact-list">
            <div class="artifact-head mono">
              <span>IRV</span>
              <span>7 блоков</span>
            </div>
            <ol>
              <li><span>hypothesis</span> — что здесь главное ограничение</li>
              <li><span>constraints</span> — физика / реализация / бизнес</li>
              <li><span>design space</span> — что отвергнуто и почему</li>
              <li><span>decisions</span> — что решили и чем пожертвовали</li>
              <li><span>consequences</span> — что из этого следует</li>
              <li><span>uncertainty</span> — где данные, а где предположение</li>
            </ol>
          </div>

          <blockquote>
            «16 GB потребовали бы 192-битной шины и другой платы — это уже
            другой продукт, а не “жадность”.»
            <cite>IRV, RX 9050</cite>
          </blockquote>

          <ul class="gates">
            <li><span class="mono">gate</span> lineage + epistemic markers</li>
          </ul>
        </div>
      </section>

      <section class="walk-step walk-step-tint" aria-labelledby="s4">
        <div class="wrap step-grid">
          <aside class="step-meta">
            <div class="step-num">04</div>
            <div class="step-label mono">Narrative</div>
            <div class="step-roles">
              <span>AI</span>
              <span>Human</span>
            </div>
          </aside>
          <div class="step-body">
            <h2 id="s4">Из анализа — в траекторию читателя.</h2>
            <p>
              IRV — инженерная правда. Дальше — Problem Space, State A,
              Resistance, Target X, Lens. QA проверяет факты, структуру и якоря.
            </p>

            <div class="qa-cards">
              <article class="qa-card qa-card-ok">
                <div class="mono">225F / clean pass</div>
                <div class="qa-value">52/52</div>
                <p>0 ошибок · опубликовано</p>
              </article>
              <article class="qa-card qa-card-stop">
                <div class="mono">9950X / editorial hold</div>
                <div class="qa-value">1 FAIL</div>
                <p>2 CRITICAL · не опубликовано</p>
              </article>
            </div>

            <ul class="gates">
              <li><span class="mono">gate</span> fact-check + structure + anchor audit</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="walk-step wrap" aria-labelledby="s5">
        <aside class="step-meta">
          <div class="step-num">05</div>
          <div class="step-label mono">Brief</div>
          <div class="step-roles">
            <span>AI</span>
            <span>Human</span>
          </div>
        </aside>
        <div class="step-body">
          <h2 id="s5">Бриф — компиляция, не вдохновение.</h2>
          <p>
            Arc превращается в Writer’s Brief: что читатель думает до, что
            должен узнать после, какие факты закрыть, какой тон и длина.
          </p>

          <div class="artifact">
            <div class="artifact-head mono">
              <span>brief</span>
              <span>extract</span>
            </div>
            <pre><code>READER COMES IN THINKING:
  «Слабая карта — значит, плохая покупка.»

LEAVE READER KNOWING:
  92 W — не компромисс, а организующий
  принцип SFF-продукта.

TONE: без вердикта
LENGTH: L</code></pre>
          </div>

          <ul class="gates">
            <li><span class="mono">gate</span> SHA sync: Arc изменился → Brief устарел</li>
          </ul>
        </div>
      </section>

      <section class="walk-step walk-step-tint" aria-labelledby="s6">
        <div class="wrap step-grid">
          <aside class="step-meta">
            <div class="step-num">06</div>
            <div class="step-label mono">Render</div>
            <div class="step-roles">
              <span>AI</span>
              <span>Human</span>
            </div>
          </aside>
          <div class="step-body">
            <h2 id="s6">Страница как сборка.</h2>
            <p>
              Prose + компоненты + дизайн-система: 14 layouts, эпистемические
              цвета, data-viz. Сборка — это ещё один гейт, а не «надеюсь,
              всё влезло».
            </p>

            <figure class="render-shot">
              <img
                src={img("igrolab-rx9050.webp")}
                alt="Страница обзора Radeon RX 9050: тёмный инженерный лонгрид с заголовком «92W»"
                width="1440"
                height="900"
                loading="lazy"
              />
              <figcaption class="mono">/gpu/radeon-rx-9050-review/</figcaption>
            </figure>

            <ul class="gates">
              <li><span class="mono">gate</span> build + links + final read</li>
            </ul>
          </div>
        </div>
      </section>

      <section class="walk-step wrap" aria-labelledby="s7">
        <aside class="step-meta">
          <div class="step-num">07</div>
          <div class="step-label mono">Feedback</div>
          <div class="step-roles">
            <span>AI</span>
            <span>Human</span>
          </div>
        </aside>
        <div class="step-body">
          <h2 id="s7">Материал не заканчивается публикацией.</h2>
          <p>
            У артефакта есть stale_if: новый драйвер, новая цена, новый
            конкурент. Система помечает материал и предлагает пересобрать.
          </p>

          <div class="artifact">
            <div class="artifact-head mono">
              <span>stale_if</span>
              <span>feedback</span>
            </div>
            <pre><code>stale_if:
  - driver_version
  - price
  - competitor
  - law_update

action: regenerate / review</code></pre>
          </div>

          <ul class="gates">
            <li><span class="mono">gate</span> coverage + freshness</li>
          </ul>
        </div>
      </section>

      <section class="walk-section wrap" aria-labelledby="before-after">
        <div class="walk-section-head">
          <div class="walk-label mono">08 / before / after</div>
          <h2 id="before-after">Что изменилось по сравнению с ручным циклом.</h2>
        </div>

        <div class="ba-table">
          <div class="ba-row ba-head mono">
            <span>Шаг</span>
            <span>Вручную</span>
            <span>В системе</span>
            <span>Человек</span>
          </div>
          {beforeAfter.map((row) => (
            <div class="ba-row">
              <span class="ba-step">{row.step}</span>
              <span>{row.manual}</span>
              <span>{row.system}</span>
              <span>{row.human}</span>
            </div>
          ))}
        </div>

        <p class="walk-note">
          Система убирает <strong>первый проход</strong>: чтение, сведение,
          проверку, поиск противоречий. Она не убирает <strong>последний</strong>:
          голос, judgment, ответственность.
        </p>
      </section>

      <section class="walk-section walk-section-tint" aria-labelledby="limits">
        <div class="wrap">
          <div class="walk-section-head">
            <div class="walk-label mono">09 / limits</div>
            <h2 id="limits">Что система не делает.</h2>
          </div>

          <div class="limit-grid">
            {limits.map((limit) => (
              <article class="limit">
                <h3>{limit.title}</h3>
                <p>{limit.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="walk-cta">
        <div class="wrap walk-cta-inner">
          <div>
            <div class="mono">AI Content Ops</div>
            <h2>Хочешь такой контур для своего сайта?</h2>
          </div>
          <div class="walk-cta-actions">
            <a class="walk-button" href={mailto}>
              Обсудить <span aria-hidden="true">↗</span>
            </a>
            <a class="walk-text-link mono" href={`${base}cases/igrolab/`}>
              вернуться к кейсу
            </a>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .walk-hero {
    border-bottom: 1px solid var(--line);
  }

  .walk-hero .wrap {
    padding-block: clamp(28px, 4vw, 56px) clamp(40px, 6vw, 76px);
  }

  .walk-back {
    display: inline-flex;
    gap: 8px;
    margin-bottom: clamp(40px, 6vw, 72px);
    color: var(--muted);
    transition: color 160ms var(--ease);
  }

  .walk-back:hover {
    color: var(--signal-text);
  }

  .walk-kicker {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .walk-title {
    max-width: 18ch;
    margin-top: clamp(26px, 4vw, 44px);
    font-family: var(--serif);
    font-size: clamp(44px, 7.4vw, 104px);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.05em;
  }

  .walk-lede {
    max-width: 58ch;
    margin-top: clamp(26px, 3.5vw, 40px);
    color: var(--ink-2);
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.45;
  }

  .walk-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }

  .walk-meta div {
    padding: 14px 18px 0;
    border-left: 1px solid var(--line);
  }

  .walk-meta div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .walk-meta dt {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .walk-meta dd {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 14px;
    line-height: 1.4;
  }

  .walk-strip {
    background: var(--ink);
    color: var(--paper);
  }

  .walk-strip ol {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .walk-strip li {
    display: grid;
    gap: 5px;
    padding: 16px 14px;
    border-left: 1px solid oklch(0.33 0.012 75);
  }

  .walk-strip li:first-child {
    border-left: 0;
  }

  .walk-strip .mono {
    color: var(--signal);
    font-size: 10px;
  }

  .walk-strip strong {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .walk-strip em {
    color: oklch(0.7 0.01 86);
    font-size: 11px;
    font-style: normal;
    line-height: 1.35;
  }

  .walk-step {
    padding-block: clamp(56px, 8vw, 104px);
    border-bottom: 1px solid var(--line);
  }

  .walk-step-tint {
    background: var(--paper-2);
  }

  .step-grid {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
  }

  .walk-step.wrap {
    display: grid;
    grid-template-columns: 160px minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
  }

  .step-meta {
    align-self: start;
    position: sticky;
    top: 24px;
  }

  .step-num {
    font-family: var(--serif);
    font-size: clamp(64px, 7vw, 96px);
    font-weight: 500;
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--signal);
  }

  .step-label {
    margin-top: 10px;
    color: var(--faint);
  }

  .step-roles {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 14px;
  }

  .step-roles span {
    padding: 3px 7px;
    border: 1px solid var(--line-strong);
    font-family: var(--mono);
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .step-roles span:first-child {
    border-color: var(--signal);
    color: var(--signal-text);
  }

  .step-body h2 {
    max-width: 22ch;
    font-family: var(--serif);
    font-size: clamp(30px, 4vw, 48px);
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: -0.04em;
  }

  .step-body > p {
    max-width: 56ch;
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 16.5px;
    line-height: 1.55;
  }

  .hardware-note {
    margin-top: 14px;
    color: var(--faint) !important;
    font-family: var(--mono);
    font-size: 11px !important;
    letter-spacing: 0.04em;
  }

  .artifact {
    margin-top: 26px;
    border: 1px solid var(--line-strong);
    background: var(--paper);
  }

  .artifact-head {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .artifact pre {
    margin: 0;
    padding: 18px 16px;
    overflow-x: auto;
    font-family: var(--mono);
    font-size: 12px;
    line-height: 1.65;
    color: var(--ink-2);
  }

  .artifact code {
    font-family: inherit;
  }

  .artifact-map {
    display: grid;
    grid-template-columns: auto 40px minmax(0, 1fr);
    align-items: center;
    gap: 0;
    padding: 18px;
    border: 0;
    background: transparent;
  }

  .map-root {
    padding: 8px 12px;
    border: 1px solid var(--signal);
    color: var(--signal-text);
  }

  .map-lines {
    height: 1px;
    background: var(--line-strong);
  }

  .artifact-map ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .artifact-map li {
    padding: 7px 10px;
    border: 1px solid var(--line-strong);
    font-family: var(--mono);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .artifact-list {
    padding-bottom: 4px;
  }

  .artifact-list ol {
    margin: 0;
    padding: 12px 18px 8px;
    list-style: none;
    counter-reset: irv;
  }

  .artifact-list li {
    display: grid;
