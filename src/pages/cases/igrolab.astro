---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site";

const base = import.meta.env.BASE_URL;
const img = (name: string) => `${base}shots/${name}`;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent("AI Content Ops: похожий контур")}`;

const steps = [
  {
    n: "01",
    title: "Карточка продукта",
    text: "Что известно, откуда и насколько свежо. Один продукт — одна карточка.",
  },
  {
    n: "02",
    title: "Проверка",
    text: "У каждой цифры источник, дата и статус: подтверждено или оценка.",
  },
  {
    n: "03",
    title: "Записка",
    text: "Ограничение, компромисс, вывод — вместо таблицы характеристик.",
  },
  {
    n: "04",
    title: "Сценарий",
    text: "Что читатель думает до и что должен понять после. Путь, а не список разделов.",
  },
  {
    n: "05",
    title: "Текст",
    text: "Автор пишет голосом. Система даёт фактуру, структуру и проверки.",
  },
  {
    n: "06",
    title: "Страница",
    text: "Дизайн собирается из системы: блоки, сетки, цвета достоверности.",
  },
];

const ledger = [
  {
    material: "Core Ultra 5 225F",
    checked: "52 факта, 6 проверок структуры",
    found: "0 ошибок, 0 противоречий",
    decision: "Опубликовано",
    tone: "ok",
  },
  {
    material: "Ryzen 7 9800X3D",
    checked: "Цифры и связанные выводы",
    found: "89 → 95 °C; выводы перестроены",
    decision: "Исправлено до публикации",
    tone: "warn",
  },
  {
    material: "Ryzen 9 9950X",
    checked: "27 фактов, 7 проверок структуры",
    found: "1 фактическая ошибка; 2 критических противоречия; 4 серьёзных; 6 средних",
    decision: "Не опубликовано",
    tone: "stop",
  },
  {
    material: "RTX 5060 Ti 16GB",
    checked: "16 утверждений, 2+ источника",
    found: "6 уточнений; 0 блокеров",
    decision: "Опубликовано",
    tone: "ok",
  },
];

const limits = [
  {
    title: "Не всё проверено автоматически",
    text: "Часть карточек ещё ждёт ручной проверки. Это следующий шаг, а не готовое обещание.",
  },
  {
    title: "Нет замера времени",
    text: "Я не считал стоимость одного материала. Это первый управленческий показатель на таком контуре.",
  },
  {
    title: "Нет своей лаборатории",
    text: "Цифры производительности — из открытых источников. Собственные замеры — отдельный стенд.",
  },
  {
    title: "Тон проверяет редактор",
    text: "Факты и структура проверяются системой. Финальный тон и ссылки — человек.",
  },
  {
    title: "Сайт собирается без автопроверок",
    text: "Сборка проходит, но ошибки на странице ловятся глазами. Для инженерного контента это слабое место.",
  },
  {
    title: "Голос — человек",
    text: "Система даёт скелет и фактуру. Живой текст появляется после автора.",
  },
];

const range = [
  {
    kicker: "Лонгрид / 8 шагов",
    title: "Frametime",
    text: "Объяснение механики: узнавание → сомнение → метафора → переворот → практика. 7,5 тыс. слов пакета → 3,1 тыс. слов статьи.",
    image: "igrolab-frametime.webp",
    href: "https://pekaboyare.ru/articles/how-frametime-works/",
    link: "Читать лонгрид",
  },
  {
    kicker: "Кейс / 8 шагов",
    title: "Oasis Node",
    text: "История решения: запрос → ограничения → альтернативы → выбор → проверка → вывод. Каждый шаг меняет картину, а не добавляет абзац.",
    image: "igrolab-oasis.webp",
    href: "https://pekaboyare.ru/builds/silent-llm-workstation",
    link: "Смотреть кейс",
  },
];

const gives = [
  {
    title: "Быстрее",
    text: "Меньше рутины на входе: сбор, сведение, проверка.",
  },
  {
    title: "Повторяемо",
    text: "Один процесс на все материалы, а не «как получится».",
  },
  {
    title: "Доверчивее",
    text: "У каждой цифры есть источник, дата и степень уверенности.",
  },
  {
    title: "Переиспользуемо",
    text: "Знание живёт дольше одной статьи: обзор, сравнение, стоимость владения.",
  },
];

const start = [
  {
    n: "01",
    title: "Аудит 3 материалов",
    text: "Где теряется время, какие факты не проверяются и что можно переиспользовать.",
  },
  {
    n: "02",
    title: "Пилот на 1–3 материалах",
    text: "Проходим полный цикл и замеряем время, ошибки и количество правок.",
  },
  {
    n: "03",
    title: "Внедрение",
    text: "Фиксируем процесс, роли и инструменты. Обучаем редакцию.",
  },
];

---

<BaseLayout
  title="ИгроЛаба — кейс: контент-процесс для экспертного сайта"
  description="Как экспертное издание производит материалы быстрее и без потери доверия: сбор, проверка, аналитическая записка, сценарий, текст, страница."
>
  <Header />

  <main id="main">
    <article class="ops">
      <header class="ops-hero">
        <div class="wrap ops-hero-inner">
          <a class="ops-back mono" href={`${base}#projects`}>
            <span aria-hidden="true">←</span> все проекты
          </a>

          <div class="ops-kicker mono">
            <span>Кейс / AI Content Ops</span>
            <span>2026</span>
          </div>

          <h1 class="ops-title">
            Контент, который нельзя<br />
            опубликовать без доказательств.
          </h1>

          <p class="ops-lede">
            ИгроЛаба — инженерный журнал о PC-железе. Я построил процесс, в
            котором система собирает факты, проверяет источники и готовит
            аналитические записки, а автор пишет голосом и отвечает за вердикт.
            Ниже — четыре материала и то, что каждый доказал.
          </p>

          <dl class="ops-meta">
            <div>
              <dt>Роль</dt>
              <dd>Процесс, редактура, дизайн</dd>
            </div>
            <div>
              <dt>Стек</dt>
              <dd>Astro · Svelte · Python · LLM</dd>
            </div>
            <div>
              <dt>Статус</dt>
              <dd>Live · 99 страниц</dd>
            </div>
            <div>
              <dt>Артефакты</dt>
              <dd>4 материала · 20 сценариев</dd>
            </div>
          </dl>

          <div class="ops-actions">
            <a class="ops-button" href="https://pekaboyare.ru" target="_blank" rel="noopener noreferrer">
              Открыть журнал <span aria-hidden="true">↗</span>
            </a>
            <a class="ops-button ops-button-ghost" href={`${base}cases/igrolab/walkthrough/`}>
              Смотреть walkthrough <span aria-hidden="true">→</span>
            </a>
            <a class="ops-text-link mono" href="https://github.com/kaizin-lab/pc_hardware_knowledge_base" target="_blank" rel="noopener noreferrer">
              база знаний <span aria-hidden="true">↗</span>
            </a>
            <a class="ops-text-link mono" href="https://github.com/jefo/pc-build-ontology" target="_blank" rel="noopener noreferrer">
              валидатор сборок <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </header>

      <div class="ops-hero-shot">
        <div class="wrap">
          <figure class="hero-figure">
            <img
              src={img("igrolab-issue.webp")}
              alt="Обложка первого выпуска ИгроЛабы: тёмный индустриальный интерфейс, заголовок «ФРЕЙМТАЙМ»"
              width="1440"
              height="900"
              loading="eager"
            />
            <figcaption class="mono">
              Выпуск №001 · журнальная модель, пять жанров, 99 страниц
            </figcaption>
          </figure>
        </div>
      </div>

      <section class="ops-section wrap" aria-labelledby="pipeline">
        <div class="ops-section-head">
          <div class="ops-label mono">01 / процесс</div>
          <h2 id="pipeline">Один материал — шесть шагов.</h2>
          <p class="ops-section-note">
            Каждый шаг оставляет след: что собрали, что проверили и что решили.
            Поэтому можно проверить не только результат, но и путь.
          </p>
        </div>

        <ol class="flow-list">
          {steps.map((step) => (
            <li class="flow-step">
              <div class="flow-top">
                <span class="flow-num mono">{step.n}</span>
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>

        <p class="flow-next">
          <a class="material-link mono" href={`${base}cases/igrolab/walkthrough/`}>
            полный цикл на одном материале <span aria-hidden="true">→</span>
          </a>
        </p>
      </section>

      <section class="ops-section ops-section-tint" aria-labelledby="materials">
        <div class="wrap">
          <div class="ops-section-head">
            <div class="ops-label mono">02 / доказательства</div>
            <h2 id="materials">Четыре материала, четыре доказательства.</h2>
            <p class="ops-section-note">
              Не «мы используем AI», а что конкретно произошло с конкретным
              текстом.
            </p>
          </div>

          <article class="material">
            <div class="material-copy">
              <div class="material-kicker mono">01 / чистая проверка</div>
              <h3>Core Ultra 5 225F</h3>
              <p>
                Материал прошёл проверку без единой ошибки: 52 утверждения,
                ноль противоречий. Тезис из задания автору дошёл до страницы
                без потерь.
              </p>
              <blockquote>
                «225F — не финальный процессор, а временный жилец сокета».
                <cite>задание автору</cite>
              </blockquote>
              <p class="material-note">
                На странице — та же мысль. Это проверка, что система не
                размывает тезис по дороге.
              </p>
              <dl class="proof">
                <div><dt>Проверено</dt><dd>52/52</dd></div>
                <div><dt>Ошибок</dt><dd>0</dd></div>
                <div><dt>Статус</dt><dd>Live</dd></div>
              </dl>
              <a class="material-link mono" href="https://pekaboyare.ru/hardware/cpu/intel-core-ultra-5-225f/" target="_blank" rel="noopener noreferrer">
                открыть материал <span aria-hidden="true">↗</span>
              </a>
            </div>
            <figure class="material-shot">
              <img src={img("igrolab-225f.webp")} alt="Страница Intel Core Ultra 5 225F: заголовок «ключ-карта к LGA1851»" width="1440" height="900" loading="lazy" />
              <figcaption class="mono">225F · страница материала</figcaption>
            </figure>
          </article>

          <article class="material material-reverse">
            <div class="material-copy">
              <div class="material-kicker mono">02 / самокоррекция</div>
              <h3>Ryzen 7 9800X3D</h3>
              <p>
                В исходных данных стояло <code>89 °C</code>. Проверка дала
                95 °C; заодно исправили ещё одну характеристику. Механическая замена
                оставила бы противоречие: цифра новая, а выводы старые.
              </p>
              <blockquote>
                «Исправить цифру недостаточно. Нужно перестроить выводы,
                которые на ней держались».
                <cite>правило после инцидента</cite>
              </blockquote>
              <p class="material-note">
                Система чинит не строку, а цепочку: где ещё используется
                эта цифра и что изменится в аргументе.
              </p>
              <dl class="proof">
                <div><dt>Поймано</dt><dd>89 → 95</dd></div>
                <div><dt>Перестроено</dt><dd>1 цепочка</dd></div>
                <div><dt>Статус</dt><dd>Исправлено</dd></div>
              </dl>
            </div>
            <div class="material-terminal" aria-label="Что изменилось после проверки">
              <div class="terminal-top mono">
                <span>Что изменилось</span>
                <span>аудит</span>
              </div>
              <ul class="terminal-list">
                <li><span>Было</span><span>89 °C</span></li>
                <li><span>Стало</span><span>95 °C</span></li>
                <li><span>Ещё</span><span>исправили характеристику</span></li>
                <li><span>Перестроили</span><span>выводы, которые держались на 89 °C</span></li>
                <li><span>Итог</span><span>материал опубликован без противоречия</span></li>
              </ul>
              <div class="terminal-foot mono">
                <span>источник</span>
                <span>AMD product page</span>
              </div>
            </div>
          </article>

          <article class="material">
            <div class="material-copy">
              <div class="material-kicker mono">03 / редакционный стоп</div>
              <h3>Ryzen 9 9950X</h3>
              <p>
                Материал выглядел готовым, но проверка нашла фактическую ошибку
                и два критических противоречия. Мы <strong>не опубликовали</strong>
                его.
              </p>
              <blockquote>
                «Лучше остановить материал, чем объяснять читателю, почему два
                числа — одно и то же».
                <cite>редакционное решение</cite>
              </blockquote>
              <p class="material-note">
                Это не провал системы. Это её работа: она умеет сказать «стоп»
                до публикации, а не после.
              </p>
              <dl class="proof">
                <div><dt>Ошибка</dt><dd>1</dd></div>
                <div><dt>Критических</dt><dd>2</dd></div>
                <div><dt>Статус</dt><dd>Стоп</dd></div>
              </dl>
            </div>
            <div class="material-verdict" aria-label="Решение по материалу 9950X">
              <div class="verdict-top mono">
                <span>9950X / проверка</span>
                <span>стоп</span>
              </div>
              <div class="verdict-status">НЕ<br />ПУБЛИКОВАТЬ</div>
              <ul class="verdict-list">
                <li><span>Факты</span><span>1 ошибка · 5 замечаний · 3 без подтверждения</span></li>
                <li><span>Структура</span><span>2 критических · 4 серьёзных · 6 средних</span></li>
                <li><span>Решение</span><span>сначала исправить, потом решать</span></li>
              </ul>
            </div>
          </article>

          <article class="material material-reverse">
            <div class="material-copy">
              <div class="material-kicker mono">04 / проверка на странице</div>
              <h3>RTX 5060 Ti 16GB</h3>
              <p>
                Проверка видна не в внутреннем отчёте, а на самой странице:
                читатель видит, что спецификации проверены и когда.
              </p>
              <blockquote>
                «Спецификации проверены · аудит 20.06.2026».
                <cite>плашка на странице</cite>
              </blockquote>
              <p class="material-note">
                Шесть уточнений — не ошибки, а границы: где источники
                расходятся, где округление. Они зафиксированы, а не спрятаны.
              </p>
              <dl class="proof">
                <div><dt>Утверждений</dt><dd>16</dd></div>
                <div><dt>Источников</dt><dd>2+</dd></div>
                <div><dt>Уточнений</dt><dd>6</dd></div>
              </dl>
              <a class="material-link mono" href="https://pekaboyare.ru/hardware/gpu/nvidia-geforce-rtx-5060-ti/" target="_blank" rel="noopener noreferrer">
                открыть материал <span aria-hidden="true">↗</span>
              </a>
            </div>
            <figure class="material-shot">
              <img src={img("igrolab-5060ti.webp")} alt="Страница RTX 5060 Ti 16GB с плашкой верификации спецификаций" width="1440" height="900" loading="lazy" />
              <figcaption class="mono">RTX 5060 Ti · провенанс на странице</figcaption>
            </figure>
          </article>
        </div>
      </section>

      <section class="ops-section wrap" aria-labelledby="ledger">
        <div class="ops-section-head">
          <div class="ops-label mono">03 / след проверки</div>
          <h2 id="ledger">Что поймали до публикации.</h2>
          <p class="ops-section-note">
            Не «всё проверено», а конкретный след: что искали, что нашли, что
            сделали.
          </p>
        </div>

        <div class="ledger">
          <div class="ledger-row ledger-head mono">
            <span>Материал</span>
            <span>Что проверяли</span>
            <span>Что нашли</span>
            <span>Решение</span>
          </div>
          {ledger.map((row) => (
            <div class={`ledger-row ledger-${row.tone}`}>
              <span class="ledger-name">{row.material}</span>
              <span>{row.checked}</span>
              <span>{row.found}</span>
              <span class="ledger-decision">{row.decision}</span>
            </div>
          ))}
        </div>

        <div class="numbers">
          <div class="number">
            <div class="number-value">99</div>
            <div class="number-label">страниц собрано</div>
            <div class="number-note mono">~8 секунд сборка</div>
          </div>
          <div class="number">
            <div class="number-value">123</div>
            <div class="number-label">карточки знаний</div>
            <div class="number-note mono">97 с описанием поведения</div>
          </div>
          <div class="number">
            <div class="number-value">20</div>
            <div class="number-label">сценариев материалов</div>
            <div class="number-note mono">6 заданий · 4 проверки</div>
          </div>
          <div class="number">
            <div class="number-value">14</div>
            <div class="number-label">проверок сборки</div>
            <div class="number-note mono">сборка не проходит молча</div>
          </div>
        </div>
      </section>

      <section class="ops-section ops-section-tint" aria-labelledby="range">
        <div class="wrap">
          <div class="ops-section-head">
            <div class="ops-label mono">04 / форматы</div>
            <h2 id="range">Не только обзоры.</h2>
            <p class="ops-section-note">
              Один контур — разные жанры. Формат меняется, дисциплина — нет.
            </p>
          </div>

          <div class="range-grid">
            {range.map((item) => (
              <article class="range-card">
                <figure>
                  <img src={img(item.image)} alt={`Материал «${item.title}»`} width="1440" height="900" loading="lazy" />
                </figure>
                <div class="range-copy">
                  <div class="material-kicker mono">{item.kicker}</div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                  <a class="material-link mono" href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.link} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="ops-section wrap" aria-labelledby="gives">
        <div class="ops-section-head">
          <div class="ops-label mono">05 / что это даёт</div>
          <h2 id="gives">Четыре вещи, которые меняются для редакции.</h2>
          <p class="ops-section-note">
            Не «стало красивее», а что конкретно перестаёт съедать время.
          </p>
        </div>

        <div class="gives-grid">
          {gives.map((item) => (
            <article class="give">
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="ops-section ops-section-tint" aria-labelledby="limits">
        <div class="wrap">
          <div class="ops-section-head">
            <div class="ops-label mono">06 / границы</div>
            <h2 id="limits">Что это не доказывает.</h2>
            <p class="ops-section-note">
              Без этого блока кейс превращается в рекламу. С ним — в рабочий
              разговор.
            </p>
          </div>

          <div class="limit-grid">
            {limits.map((limit) => (
              <article class="limit">
                <h3>{limit.title}</h3>
                <p>{limit.text}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="ops-section wrap" aria-labelledby="start">
        <div class="ops-section-head">
