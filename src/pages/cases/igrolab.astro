---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { site } from "../../data/site";

const base = import.meta.env.BASE_URL;
const img = (name: string) => `${base}shots/${name}`;
const mailto = `mailto:${site.email}?subject=${encodeURIComponent("AI Content Ops: похожий контур")}`;

const steps = [
  {
    n: "01",
    title: "KB-карточка",
    text: "Факты, цена, дата проверки, профили поведения. Один компонент — один файл.",
  },
  {
    n: "02",
    title: "Narrative Arc",
    text: "Problem → Design Space → Decision → Consequences → Tradeoff. Не outline, а карта трансформации.",
  },
  {
    n: "03",
    title: "QA",
    text: "Фактчекер и структурный аудитор параллельно. Выход — fix manifest, а не «наверное, норм».",
  },
  {
    n: "04",
    title: "Writer’s Brief",
    text: "Детерминированная компиляция арки в бриф: что читатель думает, что должен узнать, чем закрыть.",
  },
  {
    n: "05",
    title: "Prose + Astro",
    text: "Редактор пишет голос. Компоненты и данные собирают страницу.",
  },
  {
    n: "06",
    title: "Design",
    text: "Эпистемические цвета, жанровые карточки, телеметрия. Дизайн показывает достоверность.",
  },
];

const ledger = [
  {
    material: "Core Ultra 5 225F",
    checked: "52 факта, 6 структурных проверок",
    found: "0 ошибок, 0 противоречий",
    decision: "Опубликовано",
    tone: "ok",
  },
  {
    material: "Ryzen 7 9800X3D",
    checked: "TJmax, N4/N4P, зависимые propositions",
    found: "89 → 95 °C, N4 → N4P, каскад",
    decision: "Каскадный фикс",
    tone: "warn",
  },
  {
    material: "Ryzen 9 9950X",
    checked: "27 фактов, 7 структурных проверок",
    found: "1 FAIL, 2 CRITICAL, 4 HIGH, 6 MEDIUM",
    decision: "Не опубликовано",
    tone: "stop",
  },
  {
    material: "RTX 5060 Ti 16GB",
    checked: "16 утверждений, 2+ источника",
    found: "6 WARN, 0 BLOCK",
    decision: "Опубликовано",
    tone: "ok",
  },
];

const limits = [
  {
    title: "G1 не enforced",
    text: "Канонический 9800X3D имеет external_audit_verification: planned. В KB — 10 passed, 14 planned, у 99 карточек поля нет. Формальный гейт есть в методе, но не на всех записях.",
  },
  {
    title: "Нет cycle time",
    text: "Я не считал время и стоимость одного материала. Это первый управленческий показатель, который я бы поставил на таком контуре.",
  },
  {
    title: "Нет лаборатории",
    text: "FPS — из открытых источников. «Measured» часто значит «взято из обзора», а не «измерено на стенде».",
  },
  {
    title: "Нет prose QA",
    text: "Факты и арка проверяются, финальный тон и ссылки — нет. Это зафиксировано в собственном dependency graph.",
  },
  {
    title: "Нет CI у сайта",
    text: "Сборка проходит, но регрессии ловятся глазами. Для инженерного контента это слабое место.",
  },
  {
    title: "Голос — человек",
    text: "LLM даёт скелет, фактуру и вёрстку. Живой текст появляется после редактуры. Это не баг, это граница.",
  },
];

const range = [
  {
    kicker: "Longread / 8 stages",
    title: "Frametime",
    text: "7,5 тыс. слов пакета → 3,1 тыс. слов статьи. Recognition → Dissonance → Metaphor → Inversion → Tutorial → Investigation → Heuristics → Full Circle. Интерактивный метроном как якорь.",
    image: "igrolab-frametime.png",
    href: "https://pekaboyare.ru/articles/how-frametime-works/",
    link: "Читать лонгрид",
  },
  {
    kicker: "Case / 8 moves",
    title: "Oasis Node",
    text: "Инженерный кейс: expose → destabilize → false-intuition → reframe → system-expand → forensic-validate → identity-synthesize → extract. Каждый move меняет perception, а не добавляет абзац.",
    image: "igrolab-oasis.png",
    href: "https://pekaboyare.ru/builds/silent-llm-workstation",
    link: "Смотреть кейс",
  },
];
---

<BaseLayout
  title="ИгроЛаба — кейс AI Content Ops"
  description="AI Content Ops на примере инженерного журнала: 225F — 52/52 факта, 9800X3D — самокоррекция, 9950X — QA остановил публикацию, RTX 5060 Ti — провенанс на странице."
>
  <Header />

  <main id="main">
    <article class="ops">
      <header class="ops-hero">
        <div class="wrap ops-hero-inner">
          <a class="ops-back mono" href={`${base}#projects`}>
            <span aria-hidden="true">←</span> все проекты
          </a>

          <div class="ops-kicker mono">
            <span>Кейс / AI Content Ops</span>
            <span>2026</span>
          </div>

          <h1 class="ops-title">
            Контент, который нельзя<br />
            опубликовать без доказательств.
          </h1>

          <p class="ops-lede">
            ИгроЛаба — инженерный журнал о PC-железе на 99 страниц. LLM делает
            research, narrative и layout; детерминированные гейты и редактор
            решают, что выходит. Ниже — четыре материала и то, что каждый
            доказал.
          </p>

          <dl class="ops-meta">
            <div>
              <dt>Роль</dt>
              <dd>Методология, пайплайн, редактура, дизайн</dd>
            </div>
            <div>
              <dt>Стек</dt>
              <dd>Astro 6 · Svelte 5 · Python · YAML · LLM</dd>
            </div>
            <div>
              <dt>Статус</dt>
              <dd>Live · 99 страниц</dd>
            </div>
            <div>
              <dt>Артефакты</dt>
              <dd>20 arc maps · 4 QA-отчёта</dd>
            </div>
          </dl>

          <div class="ops-actions">
            <a class="ops-button" href="https://pekaboyare.ru" target="_blank" rel="noopener noreferrer">
              Открыть журнал <span aria-hidden="true">↗</span>
            </a>
            <a class="ops-text-link mono" href="https://github.com/kaizin-lab/pc_hardware_knowledge_base" target="_blank" rel="noopener noreferrer">
              база знаний <span aria-hidden="true">↗</span>
            </a>
            <a class="ops-text-link mono" href="https://github.com/jefo/pc-build-ontology" target="_blank" rel="noopener noreferrer">
              валидатор сборок <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </header>

      <div class="ops-hero-shot">
        <div class="wrap">
          <figure class="hero-figure">
            <img
              src={img("igrolab-issue.png")}
              alt="Обложка первого выпуска ИгроЛабы: тёмный индустриальный интерфейс, заголовок «ФРЕЙМТАЙМ»"
              width="1440"
              height="900"
              loading="eager"
            />
            <figcaption class="mono">
              Выпуск №001 · журнальная модель, пять жанров, 99 страниц
            </figcaption>
          </figure>
        </div>
      </div>

      <section class="ops-section wrap" aria-labelledby="pipeline">
        <div class="ops-section-head">
          <div class="ops-label mono">01 / pipeline</div>
          <h2 id="pipeline">Один материал — шесть артефактов.</h2>
          <p class="ops-section-note">
            Каждый шаг оставляет файл. Поэтому можно проверить не только
            результат, но и путь.
          </p>
        </div>

        <ol class="flow-list">
          {steps.map((step) => (
            <li class="flow-step">
              <div class="flow-top">
                <span class="flow-num mono">{step.n}</span>
              </div>
              <h3>{step.title}</h3>
              <p>{step.text}</p>
            </li>
          ))}
        </ol>
      </section>

      <section class="ops-section ops-section-tint" aria-labelledby="materials">
        <div class="wrap">
          <div class="ops-section-head">
            <div class="ops-label mono">02 / materials</div>
            <h2 id="materials">Четыре материала, четыре доказательства.</h2>
            <p class="ops-section-note">
              Не «мы используем AI», а что конкретно произошло с конкретным
              текстом.
            </p>
          </div>

          <article class="material">
            <div class="material-copy">
              <div class="material-kicker mono">01 / clean pass</div>
              <h3>Core Ultra 5 225F</h3>
              <p>
                Обзор процессора и сборки на LGA1851. Тезис: 225F — не
                финальный CPU, а ключ к платформе. QA подтвердил все 52
                утверждения, структурный аудитор не нашёл противоречий.
              </p>
              <blockquote>
                «225F покупают не ради самого процессора, а ради доступа к
                PCIe 5.0 ×20, DDR5 и апгрейд-потенциалу LGA1851 — это
                временный жилец сокета на 1–2 года.»
                <cite>Writer’s Brief</cite>
              </blockquote>
              <p class="material-note">
                На странице: «225F в этой схеме — не финальный процессор, а
                временный жилец сокета на 12–18 месяцев». Метафора и тезис
                дошли до читателя.
              </p>
              <dl class="proof">
                <div><dt>QA</dt><dd>52/52</dd></div>
                <div><dt>Ошибок</dt><dd>0</dd></div>
                <div><dt>Статус</dt><dd>Live</dd></div>
              </dl>
              <a class="material-link mono" href="https://pekaboyare.ru/hardware/cpu/intel-core-ultra-5-225f/" target="_blank" rel="noopener noreferrer">
                открыть материал <span aria-hidden="true">↗</span>
              </a>
            </div>
            <figure class="material-shot">
              <img src={img("igrolab-225f.png")} alt="Страница Intel Core Ultra 5 225F: заголовок «ключ-карта к LGA1851»" width="1440" height="900" loading="lazy" />
              <figcaption class="mono">225F · страница материала</figcaption>
            </figure>
          </article>

          <article class="material material-reverse">
            <div class="material-copy">
              <div class="material-kicker mono">02 / self-correction</div>
              <h3>Ryzen 7 9800X3D</h3>
              <p>
                В KB стояло <code>TJmax 89 °C</code> из training data. Фактчек
                дал 95 °C; заодно исправили N4 → N4P. Механическая замена
                оставила бы документ с внутренним противоречием: маркер говорит
                95, а аргумент построен на 89.
              </p>
              <blockquote>
                «When qa-arc-map fact-checker corrected the number, it did not
                cascade to dependent propositions.»
                <cite>ADR-003</cite>
              </blockquote>
              <p class="material-note">
                Поэтому появился класс <code>[factual/propagated]</code>:
                чинится не строка, а вся зависимая логика.
              </p>
              <dl class="proof">
                <div><dt>Поймано</dt><dd>89 → 95</dd></div>
                <div><dt>Каскад</dt><dd>1</dd></div>
                <div><dt>Урок</dt><dd>ADR-003</dd></div>
              </dl>
            </div>
            <div class="material-terminal" aria-label="Фрагмент ADR-003">
              <div class="terminal-top mono">
                <span>ADR-003 / G6</span>
                <span>factual/propagated</span>
              </div>
              <pre><code>[factual] TJmax
location: §1.5, "89°C"
current:  89°C
fixed:    95°C
source:   AMD product page

[propagated] "TJmax ниже чем у non-X3D"
depends_on: TJmax 95°C
status:   proposition invalidated
action:   rebuild Tradeoff + Anchor</code></pre>
              <div class="terminal-foot mono">
                <span>KB commit</span>
                <span>89 → 95 · N4 → N4P</span>
              </div>
            </div>
          </article>

          <article class="material">
            <div class="material-copy">
              <div class="material-kicker mono">03 / editorial hold</div>
              <h3>Ryzen 9 9950X</h3>
              <p>
                Внутренний материал, который <strong>не был опубликован</strong>.
                QA нашёл один факт-фейл: компиляция ядра 28 секунд против 47 у
                Phoronix. Плюс два критических противоречия: Profile 3
                рекомендует SFF, а IRV говорит «провал»; в таблице 170 W, в
                тексте 148 W.
              </p>
              <blockquote>
                «PASS — с условиями. Требуется фикс 2 критических противоречий
                перед публикацией.»
                <cite>QA Arc-Map Report</cite>
              </blockquote>
              <p class="material-note">
                Это не провал пайплайна. Это его работа: лучше остановить
                материал, чем объяснять читателю, почему два числа — одно и то
                же.
              </p>
              <dl class="proof">
                <div><dt>FAIL</dt><dd>1</dd></div>
                <div><dt>CRITICAL</dt><dd>2</dd></div>
                <div><dt>HIGH</dt><dd>4</dd></div>
                <div><dt>MEDIUM</dt><dd>6</dd></div>
              </dl>
            </div>
            <div class="material-verdict" aria-label="Вердикт QA по 9950X">
              <div class="verdict-top mono">
                <span>QA / 9950X</span>
                <span>hold</span>
              </div>
              <div class="verdict-status">PASS<br />— С УСЛОВИЯМИ</div>
              <ul class="verdict-list">
                <li><span>Факты</span><span>18/27 OK · 1 FAIL · 5 WARN · 3 UNVERIFIED</span></li>
                <li><span>Структура</span><span>2 CRITICAL · 4 HIGH · 6 MEDIUM</span></li>
                <li><span>Решение</span><span>не публиковать до фикса</span></li>
              </ul>
            </div>
          </article>

          <article class="material material-reverse">
            <div class="material-copy">
              <div class="material-kicker mono">04 / provenance</div>
              <h3>RTX 5060 Ti 16GB</h3>
              <p>
                GPU-обзор, где проверка видна не во внутреннем отчёте, а на
                странице. 16 ключевых утверждений, каждое — минимум два
                источника: TechPowerUp, Wikipedia, Tom’s Hardware, TechSpot,
                ComputerBase, 3DNews.
              </p>
              <blockquote>
                «Спецификации верифицированы · KB pc_hardware_knowledge_base ·
                Аудит 20.06.2026.»
                <cite>Плашка на странице</cite>
              </blockquote>
              <p class="material-note">
                Шесть WARN — не ошибки, а границы: TSMC 4N vs 4NP, округление
                +56% vs +55.6%, БП 550 W vs 600 W. Они зафиксированы, а не
                спрятаны.
              </p>
              <dl class="proof">
                <div><dt>Claims</dt><dd>16</dd></div>
                <div><dt>Источников</dt><dd>2+</dd></div>
                <div><dt>WARN</dt><dd>6</dd></div>
              </dl>
              <a class="material-link mono" href="https://pekaboyare.ru/hardware/gpu/nvidia-geforce-rtx-5060-ti/" target="_blank" rel="noopener noreferrer">
                открыть материал <span aria-hidden="true">↗</span>
              </a>
            </div>
            <figure class="material-shot">
              <img src={img("igrolab-5060ti.png")} alt="Страница RTX 5060 Ti 16GB с плашкой верификации спецификаций" width="1440" height="900" loading="lazy" />
              <figcaption class="mono">RTX 5060 Ti · провенанс на странице</figcaption>
            </figure>
          </article>
        </div>
      </section>

      <section class="ops-section wrap" aria-labelledby="ledger">
        <div class="ops-section-head">
          <div class="ops-label mono">03 / ledger</div>
          <h2 id="ledger">Что поймали до публикации.</h2>
          <p class="ops-section-note">
            Не «всё проверено», а конкретный след: что искали, что нашли, что
            сделали.
          </p>
        </div>

        <div class="ledger">
          <div class="ledger-row ledger-head mono">
            <span>Материал</span>
            <span>Что проверяли</span>
            <span>Что нашли</span>
            <span>Решение</span>
          </div>
          {ledger.map((row) => (
            <div class={`ledger-row ledger-${row.tone}`}>
              <span class="ledger-name">{row.material}</span>
              <span>{row.checked}</span>
              <span>{row.found}</span>
              <span class="ledger-decision">{row.decision}</span>
            </div>
          ))}
        </div>

        <div class="numbers">
          <div class="number">
            <div class="number-value">99</div>
            <div class="number-label">страниц собрано</div>
            <div class="number-note mono">~8 секунд build</div>
          </div>
          <div class="number">
            <div class="number-value">123</div>
            <div class="number-label">карточки в KB</div>
            <div class="number-note mono">97 с профилями</div>
          </div>
          <div class="number">
            <div class="number-value">20</div>
            <div class="number-label">narrative arcs</div>
            <div class="number-note mono">6 briefs · 4 QA</div>
          </div>
          <div class="number">
            <div class="number-value">14</div>
            <div class="number-label">детерминированных проверок</div>
            <div class="number-note mono">PCBO · fail closed</div>
          </div>
        </div>
      </section>

      <section class="ops-section ops-section-tint" aria-labelledby="range">
        <div class="wrap">
          <div class="ops-section-head">
            <div class="ops-label mono">04 / range</div>
            <h2 id="range">Не только обзоры.</h2>
            <p class="ops-section-note">
              Один контур — разные жанры. Формат меняется, дисциплина — нет.
            </p>
          </div>

          <div class="range-grid">
            {range.map((item) => (
              <article class="range-card">
                <figure>
                  <img src={img(item.image)} alt={`Материал «${item.title}»`} width="1440" height="900" loading="lazy" />
                </figure>
                <div class="range-copy">
                  <div class="material-kicker mono">{item.kicker}</div>
                  <h3>{item.title}</h3>
                  <p>{item.text}</p>
                  <a class="material-link mono" href={item.href} target="_blank" rel="noopener noreferrer">
                    {item.link} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="ops-section wrap" aria-labelledby="limits">
        <div class="ops-section-head">
          <div class="ops-label mono">05 / limits</div>
          <h2 id="limits">Что это не доказывает.</h2>
          <p class="ops-section-note">
            Без этого блока кейс превращается в рекламу. С ним — в рабочий
            разговор.
          </p>
        </div>

        <div class="limit-grid">
          {limits.map((limit) => (
            <article class="limit">
              <h3>{limit.title}</h3>
              <p>{limit.text}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="case-cta">
        <div class="wrap case-cta-inner">
          <div>
            <div class="mono">AI Content Ops</div>
            <h2>Нужен человек, который построит такой контур?</h2>
          </div>
          <div class="case-cta-actions">
            <a class="ops-button" href={mailto}>
              Обсудить <span aria-hidden="true">↗</span>
            </a>
            <a class="ops-text-link mono" href={`${base}#projects`}>
              вернуться к проектам
            </a>
          </div>
        </div>
      </section>
    </article>
  </main>

  <Footer />
</BaseLayout>

<style>
  .ops-hero {
    border-bottom: 1px solid var(--line);
  }

  .ops-hero-inner {
    padding-block: clamp(28px, 4vw, 56px) clamp(40px, 6vw, 76px);
  }

  .ops-back {
    display: inline-flex;
    gap: 8px;
    margin-bottom: clamp(40px, 6vw, 72px);
    color: var(--muted);
    transition: color 160ms var(--ease);
  }

  .ops-back:hover {
    color: var(--signal-text);
  }

  .ops-kicker {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
    color: var(--faint);
  }

  .ops-title {
    max-width: 28ch;
    margin-top: clamp(26px, 4vw, 44px);
    font-family: var(--serif);
    font-size: clamp(40px, 6vw, 84px);
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.05em;
  }

  .ops-lede {
    max-width: 58ch;
    margin-top: clamp(26px, 3.5vw, 40px);
    color: var(--ink-2);
    font-size: clamp(17px, 1.7vw, 21px);
    line-height: 1.45;
  }

  .ops-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(40px, 5vw, 64px);
    border-top: 1px solid var(--line);
  }

  .ops-meta div {
    padding: 14px 18px 0;
    border-left: 1px solid var(--line);
  }

  .ops-meta div:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .ops-meta dt {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
