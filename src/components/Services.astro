---
import { services } from "../data/site";
---

<section id="services" class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>Услуги</h2>
      <p class="section-note">Проект · контракт · аудит</p>
    </div>

    <ol class="service-list">
      {services.map((service, index) => (
        <li class="service reveal">
          <span class="service-num mono-sm">{String(index + 1).padStart(2, "0")}</span>
          <h3 class="service-title">{service.title}</h3>
          <p class="service-text">{service.text}</p>
          <ul class="service-tags" aria-label="Технологии">
            {service.tags.map((tag) => <li>{tag}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .service-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .service {
    display: grid;
    grid-template-columns: 48px minmax(0, 1.05fr) minmax(0, 1.4fr) minmax(140px, 0.7fr);
    gap: 24px;
    align-items: start;
    padding: 28px 0;
    border-top: 1px solid var(--line);
    transition: background 200ms var(--ease), color 200ms var(--ease),
      padding 200ms var(--ease), margin 200ms var(--ease);
  }

  .service-num {
    padding-top: 9px;
    color: var(--faint);
    transition: color 200ms var(--ease);
  }

  .service-title {
    font-family: var(--serif);
    font-size: clamp(26px, 2.8vw, 36px);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 500;
  }

  .service-text {
    max-width: 52ch;
    padding-top: 4px;
    color: var(--muted);
    font-size: 16px;
    line-height: 1.5;
    transition: color 200ms var(--ease);
  }

  .service-tags {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    margin: 0;
    padding: 5px 0 0;
    list-style: none;
  }

  .service-tags li {
    padding: 4px 7px;
    border: 1px solid var(--line-strong);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    white-space: nowrap;
    transition: color 200ms var(--ease), border-color 200ms var(--ease);
  }

  .service:hover {
    margin-inline: -20px;
    padding-inline: 20px;
    background: var(--ink);
    color: var(--paper);
  }

  .service:hover .service-num {
    color: oklch(0.72 0.18 35);
  }

  .service:hover .service-text {
    color: oklch(0.82 0.008 86);
  }

  .service:hover .service-tags li {
    color: oklch(0.86 0.008 86);
    border-color: oklch(0.45 0.012 75);
  }

  @media (max-width: 980px) {
    .service {
      grid-template-columns: 40px minmax(0, 1fr) minmax(0, 1.2fr);
      gap: 16px 20px;
    }
    .service-tags {
      grid-column: 2 / -1;
      justify-content: flex-start;
      padding-top: 2px;
    }
  }

  @media (max-width: 680px) {
    .service {
      grid-template-columns: 1fr;
      gap: 10px;
      padding: 24px 0;
    }
    .service-num {
      padding: 0;
    }
    .service-title {
      font-size: 28px;
    }
    .service-text {
      font-size: 15.5px;
    }
    .service-tags {
      grid-column: 1;
      padding-top: 6px;
    }
    .service:hover {
      margin-inline: -12px;
      padding-inline: 12px;
    }
  }
</style>
