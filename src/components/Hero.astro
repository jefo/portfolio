---
import { site } from "../data/site";
---

<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-main">
      <h1 class="hero-title">
        <span class="hero-line" style="--d: 40ms">Боты,</span>
        <span class="hero-line" style="--d: 120ms">которые не бросают</span>
        <span class="hero-line" style="--d: 200ms">диалог</span>
        <span class="hero-line" style="--d: 280ms">на полпути.</span>
      </h1>

      <div class="hero-foot">
        <p class="hero-lede">
          Telegram-боты, AI-автоматизация и небольшие сервисы.
          От сценария и прототипа до тестов и запуска.
        </p>
        <div class="hero-actions">
          <a class="hero-mail" href={`mailto:${site.email}`}>
            {site.email}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="hero-jump mono" href="#projects">Смотреть проекты <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>

    <aside class="hero-aside" aria-label="Коротко">
      <p class="status">
        <span class="status-dot" aria-hidden="true"></span>
        {site.availability}
      </p>

      <div class="flow-panel" aria-label="Пример сценария: запись на приём">
        <div class="flow-head">
          <span>flow / appointment</span>
          <span>demo</span>
        </div>
        <ol class="flow">
          <li class="done"><span class="flow-num">01</span> index</li>
          <li class="done"><span class="flow-num">02</span> service</li>
          <li class="active"><span class="flow-num">03</span> name</li>
          <li><span class="flow-num">04</span> phone</li>
          <li><span class="flow-num">05</span> confirm</li>
          <li><span class="flow-num">06</span> done</li>
        </ol>
        <div class="flow-foot">
          <span>nextState</span>
          <span>→ phone</span>
        </div>
      </div>

      <dl class="hero-facts">
        <div>
          <dt>Формат</dt>
          <dd>Проект · контракт</dd>
        </div>
        <div>
          <dt>Локация</dt>
          <dd>{site.location}</dd>
        </div>
      </dl>

      <p class="aside-note">
        Пишите, если нужен бот, интеграция или разбор существующего.
      </p>
    </aside>
  </div>
</section>

<style>
  .hero {
    border-bottom: 1px solid var(--line);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 3.15fr) minmax(230px, 0.85fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: end;
    padding-block: clamp(52px, 8.5vw, 118px) clamp(44px, 6.5vw, 84px);
  }

  .hero-title {
    font-family: var(--serif);
    font-size: clamp(46px, 7.35vw, 102px);
    line-height: 0.93;
    letter-spacing: -0.048em;
    font-weight: 520;
    max-width: 13ch;
  }

  .hero-foot {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px 48px;
    align-items: end;
    margin-top: clamp(34px, 5vw, 58px);
    padding-top: 22px;
    border-top: 1px solid var(--line);
  }

  .hero-lede {
    max-width: 46ch;
    color: var(--ink-2);
    font-size: clamp(17px, 1.5vw, 20px);
    line-height: 1.42;
  }

  .hero-actions {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .hero-mail {
    font-family: var(--serif);
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
    text-decoration-color: var(--faint);
    transition: color 180ms var(--ease), text-decoration-color 180ms var(--ease);
  }

  .hero-mail span {
    display: inline-block;
    transition: transform 220ms var(--ease);
  }

  .hero-mail:hover {
    color: var(--signal-text);
    text-decoration-color: var(--signal);
  }

  .hero-mail:hover span {
    transform: translate(3px, -3px);
  }

  .hero-jump {
    padding-block: 4px;
    color: var(--muted);
    transition: color 180ms var(--ease);
  }

  .hero-jump:hover {
    color: var(--signal-text);
  }

  .hero-aside {
    padding-left: clamp(20px, 2.4vw, 32px);
    border-left: 1px solid var(--line);
  }

  .status {
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 26px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: var(--signal);
    animation: breathe 2.6s ease-in-out infinite;
  }

  @keyframes breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.35;
    }
  }

  .flow-panel {
    margin-bottom: 22px;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }

  .flow-head,
  .flow-foot {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .flow-head {
    margin-bottom: 10px;
  }

  .flow {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .flow li {
    position: relative;
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: 3px 0;
    font-family: var(--mono);
    font-size: 11px;
    line-height: 1.3;
    color: var(--faint);
  }

  .flow li::before {
    content: "";
    flex: 0 0 auto;
    width: 4px;
    height: 4px;
    background: var(--line-strong);
    transform: translateY(-1px);
  }

  .flow li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: 1.5px;
    top: 11px;
    bottom: -2px;
    width: 1px;
    background: var(--line);
  }

  .flow li.done {
    color: var(--muted);
  }

  .flow li.done::before {
    background: var(--ink-2);
  }

  .flow li.active {
    color: var(--ink);
    font-weight: 600;
  }

  .flow li.active::before {
    background: var(--signal);
    box-shadow: 0 0 0 3px var(--tint-signal);
  }

  .flow-num {
    width: 16px;
    color: var(--faint);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.04em;
  }

  .flow-foot {
    margin-top: 10px;
    padding-top: 8px;
    border-top: 1px solid var(--line);
  }

  .flow-foot span:last-child {
    color: var(--ink-2);
  }

  .hero-facts {
    display: grid;
    gap: 0;
  }

  .hero-facts div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3px;
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }

  .hero-facts dt {
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .hero-facts dd {
    font-size: 14px;
    line-height: 1.35;
    color: var(--ink-2);
  }

  .aside-note {
    margin-top: 24px;
    max-width: 26ch;
    font-size: 13.5px;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .hero-grid {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .hero-aside {
      padding: 22px 0 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .status {
      margin-bottom: 18px;
    }
    .flow-panel {
      max-width: 360px;
    }
    .hero-facts {
      grid-template-columns: repeat(2, 1fr);
      margin-top: 18px;
    }
    .hero-facts div {
      padding: 10px 18px;
      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }
    .hero-facts div:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .aside-note {
      margin-top: 18px;
      max-width: 52ch;
    }
  }

  @media (max-width: 720px) {
    .hero-foot {
      grid-template-columns: 1fr;
      align-items: start;
    }
    .hero-aside {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .hero-facts {
      grid-template-columns: 1fr;
    }
    .hero-facts div {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      padding: 9px 0;
      border-left: 0;
      border-top: 1px solid var(--line);
    }
    .hero-facts dd {
      text-align: right;
    }
    .status {
      padding-bottom: 2px;
    }
  }
</style>
