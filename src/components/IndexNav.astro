---
import { contents } from "../data/site";
---

<nav class="index-nav" aria-label="Разделы страницы">
  <div class="wrap index-grid">
    {contents.map((item, index) => (
      <a class="index-link" href={item.href}>
        <span class="index-num mono-sm">{String(index + 1).padStart(2, "0")}</span>
        <span class="index-label">{item.label}</span>
        <span class="index-arrow" aria-hidden="true">↗</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .index-nav {
    border-bottom: 1px solid var(--line);
  }

  .index-grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
  }

  .index-link {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 10px;
    min-height: 76px;
    padding: 16px 18px;
    border-left: 1px solid var(--line);
    transition: background 180ms var(--ease);
  }

  .index-link:first-child {
    border-left: 0;
    padding-left: 0;
  }

  .index-link:hover {
    background: var(--paper-2);
  }

  .index-link:hover .index-label {
    color: var(--signal-text);
  }

  .index-link:hover .index-arrow {
    transform: translate(2px, -2px);
    color: var(--signal-text);
  }

  .index-num {
    color: var(--faint);
  }

  .index-label {
    font-family: var(--serif);
    font-size: 18px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    transition: color 180ms var(--ease);
  }

  .index-arrow {
    align-self: end;
    font-family: var(--mono);
    font-size: 12px;
    color: var(--faint);
    transition: transform 180ms var(--ease), color 180ms var(--ease);
  }

  @media (max-width: 860px) {
    .index-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .index-link:nth-child(4) {
      border-left: 0;
      padding-left: 0;
    }
    .index-link:nth-child(n + 4) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .index-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .index-link {
      min-height: 64px;
      padding: 12px 14px;
    }
    .index-link:nth-child(odd) {
      border-left: 0;
      padding-left: 0;
    }
    .index-link:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
    .index-label {
      font-size: 16px;
    }
  }
</style>
