---
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
  index: number;
  featured?: boolean;
}

const { project, index, featured = false } = Astro.props;
const { data } = project;
const base = import.meta.env.BASE_URL;
const number = String(index + 1).padStart(2, "0");
const cover = data.cover ? `${base}${data.cover.replace(/^\//, "")}` : null;
const categoryLabel = data.category === "bot" ? "Бот" : data.category === "engine" ? "Движок" : "Домен";
---

<article
  id={`project-${project.id}`}
  class:list={["project-card", `accent-${data.accent}`, { featured }]}
  data-project
  data-category={data.category}
>
  <a class="project-main" href={data.caseUrl}>
    <div class="cover">
      <div class="cover-meta">
        <span>{data.kind}</span>
      </div>
      <span class="cover-num" aria-hidden="true">{number}</span>
      <span class="cover-mark" aria-hidden="true"></span>

      {cover ? (
        <img
          class:list={["cover-image", `cover-image-${data.coverType}`]}
          src={cover}
          alt={`Фрагмент интерфейса проекта ${data.title}`}
          loading={featured ? "eager" : "lazy"}
          decoding="async"
          width="840"
          height="1680"
        />
      ) : (
        <span class="cover-glyph" aria-hidden="true">{data.title.charAt(0)}</span>
      )}
    </div>

    <div class="project-body">
      <div class="project-topline">
        <span>{categoryLabel} · {data.year}</span>
        <span class="project-arrow" aria-hidden="true">↗</span>
      </div>

      <h3 class="project-title">{data.title}</h3>
      <p class="project-summary">{data.summary}</p>

      <ul class="project-stack" aria-label="Стек">
        {data.stack.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </a>

  <div class="project-foot">
    <span>{data.tests ?? data.status}</span>
    <div class="project-links">
      {data.repo && (
        <a href={data.repo} target="_blank" rel="noopener noreferrer">код <span aria-hidden="true">↗</span></a>
      )}
      {data.caseUrl && <a href={data.caseUrl}>разбор <span aria-hidden="true">↗</span></a>}
      {!data.repo && !data.caseUrl && <span class="project-closed">код закрыт</span>}
    </div>
  </div>
</article>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--paper);
    transition: background 200ms var(--ease);
  }

  .project-card:hover {
    background: var(--paper-2);
  }

  .accent-signal {
    --card-accent: var(--signal);
    --card-tint: var(--tint-signal);
  }

  .accent-blue {
    --card-accent: var(--blue);
    --card-tint: var(--tint-blue);
  }

  .accent-green {
    --card-accent: var(--green);
    --card-tint: var(--tint-green);
  }

  .project-main {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }

  .cover {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--card-tint);
    border-bottom: 1px solid var(--line);
  }

  .cover-meta {
    position: absolute;
    top: 16px;
    left: 20px;
    z-index: 3;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-2);
  }

  .cover-num {
    position: absolute;
    left: 18px;
    bottom: 4px;
    z-index: 1;
    font-family: var(--serif);
    font-size: clamp(80px, 11vw, 132px);
    font-weight: 470;
    line-height: 0.76;
    letter-spacing: -0.06em;
    color: var(--card-accent);
    opacity: 0.18;
  }

  @supports (-webkit-text-stroke: 1px black) {
    .cover-num {
      color: transparent;
      -webkit-text-stroke: 1px var(--card-accent);
      opacity: 0.55;
    }
  }

  .cover-mark {
    position: absolute;
    top: 16px;
    right: 20px;
    z-index: 3;
    width: 8px;
    height: 8px;
    background: var(--card-accent);
  }

  .cover-glyph {
    position: absolute;
    right: 8%;
    bottom: -9%;
    z-index: 1;
    font-family: var(--serif);
    font-size: clamp(160px, 18vw, 260px);
    font-weight: 460;
    line-height: 0.7;
    letter-spacing: -0.07em;
    color: var(--card-accent);
    opacity: 0.24;
  }

  .cover-image {
    position: absolute;
    z-index: 2;
    border: 1px solid var(--ink);
    object-fit: contain;
    object-position: top;
    filter: grayscale(1) contrast(1.02);
    transition: filter 500ms var(--ease), transform 600ms var(--ease);
  }

  .cover-image-phone {
    top: 12%;
    right: 9%;
    width: 29%;
    height: auto;
    max-height: 78%;
  }

  .cover-image-wide {
    top: 17%;
    right: 10%;
    width: 58%;
    height: auto;
    max-height: 66%;
    object-position: top;
  }

  .project-card:hover .cover-image {
    filter: none;
    transform: translateY(-6px);
  }

  .project-body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 22px 24px 26px;
  }

  .project-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .project-arrow {
    font-size: 15px;
    line-height: 1;
    color: var(--faint);
    transition: transform 200ms var(--ease), color 200ms var(--ease);
  }

  .project-card:hover .project-arrow {
    transform: translate(3px, -3px);
    color: var(--signal-text);
  }

  .project-title {
    margin-top: 12px;
    font-family: var(--serif);
    font-size: clamp(28px, 2.7vw, 38px);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 500;
  }

  .project-summary {
    margin-top: 12px;
    max-width: 46ch;
    color: var(--muted);
    font-size: 15.5px;
    line-height: 1.45;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 5px 12px;
    margin: auto 0 0;
    padding: 20px 0 0;
    list-style: none;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .project-stack li:not(:last-child)::after {
    content: "·";
    margin-left: 12px;
    color: var(--muted);
  }

  .project-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 11px 24px;
    border-top: 1px solid var(--line);
    font-family: var(--mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--faint);
  }

  .project-links {
    display: flex;
    gap: 14px;
    flex-shrink: 0;
  }

  .project-links a {
    padding-block: 6px;
    color: var(--muted);
    transition: color 160ms var(--ease);
  }

  .project-links a:hover {
    color: var(--signal-text);
  }

  .project-closed {
    padding-block: 6px;
    color: var(--muted);
    opacity: 0.8;
  }

  .featured {
    grid-column: span 2;
  }

  .featured .project-main {
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
  }

  .featured .cover {
    min-height: 420px;
    aspect-ratio: auto;
    border-right: 1px solid var(--line);
    border-bottom: 0;
  }

  .featured .cover-image-phone {
    top: 11%;
    right: 11%;
    width: 30%;
    height: auto;
    max-height: 78%;
  }

  .featured .cover-num {
    font-size: clamp(110px, 13vw, 190px);
    left: 24px;
  }

  .featured .project-body {
    justify-content: center;
    padding: clamp(26px, 4vw, 48px);
  }

  .featured .project-title {
    font-size: clamp(40px, 4.6vw, 64px);
  }

  .featured .project-summary {
    font-size: 17px;
    max-width: 34ch;
  }

  .featured .project-foot {
    border-top: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .featured .cover {
      min-height: 340px;
    }
    .featured .project-title {
      font-size: clamp(34px, 5vw, 48px);
    }
  }

  @media (max-width: 760px) {
    .featured {
      grid-column: span 1;
    }
    .featured .project-main {
      grid-template-columns: 1fr;
    }
    .featured .cover {
      min-height: 0;
      aspect-ratio: 16 / 10;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .featured .cover-image-phone {
      top: 12%;
      right: 9%;
      width: 29%;
      height: auto;
      max-height: 78%;
    }
    .featured .project-body {
      padding: 22px 24px 26px;
    }
    .featured .project-summary {
      font-size: 15.5px;
      max-width: 46ch;
    }
  }

  @media (max-width: 480px) {
    .project-body {
      padding: 20px 18px 22px;
    }
    .project-foot {
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 10px 18px;
    }
    .project-links {
      width: 100%;
      justify-content: space-between;
    }
    .project-title {
      font-size: 30px;
    }
  }
</style>
