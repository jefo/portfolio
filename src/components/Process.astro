---
import { process } from "../data/site";
---

<section id="process" class="section">
  <div class="wrap">
    <div class="section-head reveal">
      <h2>Как я работаю</h2>
      <p class="section-note">Короткие этапы.<br />Без сюрпризов в конце.</p>
    </div>

    <ol class="process-list">
      {process.map((step, index) => (
        <li class="step reveal">
          <span class="step-num mono-sm">{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process-list {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    border-bottom: 1px solid var(--line);
  }

  .step {
    padding: 18px 24px 34px;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .step:first-child {
    padding-left: 0;
    border-left: 0;
  }

  .step-num {
    display: block;
    margin-bottom: 42px;
    color: var(--signal-text);
  }

  .step h3 {
    font-family: var(--serif);
    font-size: clamp(24px, 2.3vw, 30px);
    line-height: 1.05;
    letter-spacing: -0.03em;
    font-weight: 500;
  }

  .step p {
    margin-top: 10px;
    max-width: 28ch;
    color: var(--muted);
    font-size: 15px;
    line-height: 1.48;
  }

  @media (max-width: 900px) {
    .process-list {
      grid-template-columns: repeat(2, 1fr);
    }
    .step:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .step:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .process-list {
      grid-template-columns: 1fr;
    }
    .step {
      padding: 18px 0 26px;
      border-left: 0;
    }
    .step-num {
      margin-bottom: 18px;
    }
    .step p {
      max-width: 44ch;
    }
  }
</style>
